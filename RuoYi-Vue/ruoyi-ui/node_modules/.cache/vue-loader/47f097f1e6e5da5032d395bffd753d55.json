{"remainingRequest":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\src\\views\\iot\\device\\product-list.vue?vue&type=script&lang=js","dependencies":[{"path":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\src\\views\\iot\\device\\product-list.vue","mtime":1780922369603},{"path":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1781061437342},{"path":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\node_modules\\babel-loader\\lib\\index.js","mtime":1781061438494},{"path":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1781061437342},{"path":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\node_modules\\vue-loader\\lib\\index.js","mtime":1781061438994}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["product-list.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAwDA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"product-list.vue","sourceRoot":"src/views/iot/device","sourcesContent":["<template>\r\n<el-dialog title=\"选择产品\" :visible.sync=\"open\" width=\"800px\" append-to-body>\r\n    <div style=\"margin-top:-55px;\">\r\n        <el-divider style=\"margin-top:-30px;\"></el-divider>\r\n        <el-form :model=\"queryParams\" ref=\"queryForm\" :inline=\"true\" label-width=\"68px\">\r\n            <el-form-item label=\"产品名称\" prop=\"productName\">\r\n                <el-input v-model=\"queryParams.productName\" placeholder=\"请输入产品名称\" clearable size=\"small\" @keyup.enter.native=\"handleQuery\" />\r\n            </el-form-item>\r\n            <el-form-item>\r\n                <el-button type=\"primary\" icon=\"el-icon-search\" size=\"mini\" @click=\"handleQuery\">搜索</el-button>\r\n                <el-button icon=\"el-icon-refresh\" size=\"mini\" @click=\"resetQuery\">重置</el-button>\r\n            </el-form-item>\r\n        </el-form>\r\n\r\n        <el-table v-loading=\"loading\" ref=\"singleTable\" :data=\"productList\" @row-click=\"rowClick\" highlight-current-row size=\"mini\">\r\n            <el-table-column label=\"选择\" width=\"50\" align=\"center\">\r\n                <template slot-scope=\"scope\">\r\n                    <input type=\"radio\" :checked=\"scope.row.isSelect\" name=\"product\" />\r\n                </template>\r\n            </el-table-column>\r\n            <el-table-column label=\"产品名称\" align=\"center\" prop=\"productName\" />\r\n            <el-table-column label=\"分类名称\" align=\"center\" prop=\"categoryName\" />\r\n            <el-table-column label=\"租户名称\" align=\"center\" prop=\"tenantName\" />\r\n            <el-table-column label=\"授权码\" align=\"center\" prop=\"status\" width=\"70\">\r\n                <template slot-scope=\"scope\">\r\n                    <el-tag type=\"success\" v-if=\"scope.row.isAuthorize==1\">启用</el-tag>\r\n                    <el-tag type=\"info\" v-if=\"scope.row.isAuthorize==0\">未启用</el-tag>\r\n                </template>\r\n            </el-table-column>\r\n            <el-table-column label=\"认证方式\" align=\"center\" prop=\"status\">\r\n                <template slot-scope=\"scope\">\r\n                    <dict-tag :options=\"dict.type.iot_vertificate_method\" :value=\"scope.row.vertificateMethod\" />\r\n                </template>\r\n            </el-table-column>\r\n            <el-table-column label=\"联网方式\" align=\"center\" prop=\"networkMethod\">\r\n                <template slot-scope=\"scope\">\r\n                    <dict-tag :options=\"dict.type.iot_network_method\" :value=\"scope.row.networkMethod\" />\r\n                </template>\r\n            </el-table-column>\r\n            <el-table-column label=\"创建时间\" align=\"center\" prop=\"createTime\" width=\"100\">\r\n                <template slot-scope=\"scope\">\r\n                    <span>{{ parseTime(scope.row.createTime, '{y}-{m}-{d}') }}</span>\r\n                </template>\r\n            </el-table-column>\r\n        </el-table>\r\n\r\n        <pagination v-show=\"total>0\" :total=\"total\" :page.sync=\"queryParams.pageNum\" :limit.sync=\"queryParams.pageSize\" @pagination=\"getList\" />\r\n    </div>\r\n    <div slot=\"footer\" class=\"dialog-footer\">\r\n        <el-button @click=\"confirmSelectProduct\" type=\"primary\">确定</el-button>\r\n        <el-button @click=\"closeDialog\" type=\"info\">关 闭</el-button>\r\n    </div>\r\n</el-dialog>\r\n</template>\r\n\r\n<script>\r\nimport {\r\n    listProduct,\r\n} from \"@/api/iot/product\";\r\n\r\nexport default {\r\n    name: \"ProductList\",\r\n    dicts: ['iot_vertificate_method', 'iot_network_method'],\r\n    props: {\r\n        productId: {\r\n            type: Number,\r\n            default: 0\r\n        }\r\n    },\r\n    data() {\r\n        return {\r\n            // 遮罩层\r\n            loading: true,\r\n            // 总条数\r\n            total: 0,\r\n            // 打开选择产品对话框\r\n            open: false,\r\n            // 产品列表\r\n            productList: [],\r\n            // 选中的产品\r\n            product: {},\r\n            // 查询参数\r\n            queryParams: {\r\n                pageNum: 1,\r\n                pageSize: 10,\r\n                productName: null,\r\n                categoryId: null,\r\n                categoryName: null,\r\n                tenantId: null,\r\n                tenantName: null,\r\n                isSys: null,\r\n                status: 2, //已发布\r\n                deviceType: null,\r\n                networkMethod: null,\r\n            },\r\n        };\r\n    },\r\n    created() {\r\n\r\n    },\r\n    methods: {\r\n        /** 查询产品列表 */\r\n        getList() {\r\n            this.loading = true;\r\n            listProduct(this.queryParams).then(response => {\r\n                this.productList = response.rows;\r\n                this.total = response.total;\r\n                if (this.productId != 0) {\r\n                    this.setRadioSelected(this.productId);\r\n                }\r\n                this.loading = false;\r\n            });\r\n        },\r\n        /** 搜索按钮操作 */\r\n        handleQuery() {\r\n            this.queryParams.pageNum = 1;\r\n            this.getList();\r\n        },\r\n        /** 重置按钮操作 */\r\n        resetQuery() {\r\n            this.resetForm(\"queryForm\");\r\n            this.handleQuery();\r\n        },\r\n        /** 单选数据 */\r\n        rowClick(product) {\r\n            if (product != null) {\r\n                this.setRadioSelected(product.productId);\r\n                this.product = product;\r\n            }\r\n        },\r\n        /** 设置单选按钮选中 */\r\n        setRadioSelected(productId) {\r\n            for (let i = 0; i < this.productList.length; i++) {\r\n                if (this.productList[i].productId == productId) {\r\n                    this.productList[i].isSelect = true;\r\n                } else {\r\n                    this.productList[i].isSelect = false;\r\n                }\r\n            }\r\n        },\r\n        /**确定选择产品，产品传递给父组件 */\r\n        confirmSelectProduct() {\r\n            this.$emit('productEvent', this.product);\r\n            this.open = false;\r\n        },\r\n        /**关闭对话框 */\r\n        closeDialog() {\r\n            this.open = false;\r\n        }\r\n    }\r\n};\r\n</script>\r\n"]}]}