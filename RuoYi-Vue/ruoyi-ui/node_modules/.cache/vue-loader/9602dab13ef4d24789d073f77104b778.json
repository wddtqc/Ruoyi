{"remainingRequest":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\src\\views\\agriculture\\components\\SearchMenu\\index.vue?vue&type=script&lang=js","dependencies":[{"path":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\src\\views\\agriculture\\components\\SearchMenu\\index.vue","mtime":1780922369593},{"path":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1781061437342},{"path":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\node_modules\\babel-loader\\lib\\index.js","mtime":1781061438494},{"path":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1781061437342},{"path":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\node_modules\\vue-loader\\lib\\index.js","mtime":1781061438994}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["index.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAqFA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"index.vue","sourceRoot":"src/views/agriculture/components/SearchMenu","sourcesContent":["<template>\r\n  <div class=\"search-menu\">\r\n    <div class=\"search-menu-header\">{{title}}</div>\r\n    <div class=\"search-menu-body\">\r\n      <el-input\r\n        v-model=\"queryParams[searchParma]\"\r\n        @input=\"handleInput\"\r\n        :placeholder=\"searchPlaceholder\"\r\n        suffix-icon=\"el-icon-search\"\r\n      >\r\n      </el-input>\r\n\r\n      <el-menu\r\n        v-if=\"list.length > 0\"\r\n        @select=\"handleSelect\"\r\n        v-loading=\"loading\"\r\n        :collapse-transition=\"false\"\r\n        :default-active=\"defaultActive\"\r\n      >\r\n        <template v-if=\"isSub\">\r\n          <el-submenu\r\n            v-for=\"(item,index) in list\"\r\n            :index=\"index.toString()\"\r\n            :key=\"item[keyName]\"\r\n          >\r\n            <template slot=\"title\">\r\n              <svg-icon\r\n                :icon-class=\"icon\"\r\n                class=\"margin-left-5 margin-right-10\"\r\n              />\r\n              <span slot=\"title\">{{\r\n                item[labelName].length > 11 ? `${item[labelName].substring(0, 11)}...`: item[labelName]\r\n              }}</span>\r\n            </template>\r\n            <template v-if=\"item.children.length>0\">\r\n                <el-menu-item   v-for=\"subItem in item.children\" :key=\"subItem[subKeyName]\" :index=\"subItem[subKeyName].toString()\" :disabled=\"subTag[subItem[subTag.propertyName]].disable\">\r\n                <template #title >\r\n                    <svg-icon :icon-class=\"subIcon\" class=\"margin-left-10 margin-right-5\" />\r\n                    <span class=\"font-size-13\">{{subItem[subLabelName].length > 11? `${subItem[subLabelName].substring(0, 11)}...`: subItem[subLabelName]}}</span>\r\n                    <el-tag class=\"margin-left-5\" :type=\"subTag[subItem[subTag.propertyName]].type\" size=\"mini\">{{subTag[subItem[subTag.propertyName]].text}}</el-tag>\r\n                </template>\r\n                </el-menu-item>\r\n            </template>\r\n            <template v-else>\r\n                <div class=\"font-size-12 flex jcc\">\r\n                    暂无数据\r\n                </div>\r\n            </template>\r\n\r\n          </el-submenu>\r\n        </template>\r\n        <template v-else>\r\n          <el-menu-item\r\n            v-for=\"(item, index) in list\"\r\n            :index=\"index.toString()\"\r\n            :key=\"index\"\r\n            :class=\"customClass\"\r\n          >\r\n            <template #title>\r\n                <slot :data=\"item\">\r\n                    <svg-icon :icon-class=\"icon\" class=\"margin-left-5 margin-right-5\" />\r\n                    <span>{{item[labelName].length > 11? `${item[labelName].substring(0, 11)}...`: item[labelName]}}</span>\r\n                </slot>\r\n            </template>\r\n          </el-menu-item>\r\n        </template>\r\n      </el-menu>\r\n      <el-empty v-else :image-size=\"100\" description=\"暂无数据\"></el-empty>\r\n    </div>\r\n    <div class=\"search-menu-footer\">\r\n      <el-pagination\r\n        small\r\n        background\r\n        layout=\"prev, pager, next\"\r\n        :page-size=\"queryParams.pageSize\"\r\n        :total=\"total\"\r\n        @current-change=\"handlePagination\"\r\n        @prev-click=\"handlePagination\"\r\n        @next-click=\"handlePagination\"\r\n      >\r\n      </el-pagination>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nexport default {\r\n  name: 'SearchMenu',\r\n  props: {\r\n    title:{\r\n        type:String,\r\n    },\r\n    fun: [Function],\r\n    searchParma: [String],\r\n    searchPlaceholder: [String],\r\n    keyName: [String],\r\n    labelName: [String],\r\n    activeMenu: {\r\n      type: Object,\r\n      default:function(){\r\n          return{\r\n              isActive:false,\r\n              name:'',//属性\r\n              value:''//值\r\n          }\r\n      }\r\n    },\r\n    icon: {\r\n      type: String,\r\n      default: 'land',\r\n    },\r\n    isSub: false,\r\n    subIcon:{\r\n        type:String,\r\n        default:'channel'\r\n    },\r\n    subKeyName:[String],\r\n    subLabelName:[String],\r\n    subTag:Object,\r\n    customClass:{\r\n        type:String,\r\n        default:''\r\n    }\r\n  },\r\n  data() {\r\n    return {\r\n      loading: false,\r\n      list: [],\r\n      total: null,\r\n      queryParams: {\r\n        pageNum: 1,\r\n        pageSize: 16,\r\n        [this.searchParma]: null,\r\n      },\r\n    };\r\n  },\r\n  computed:{\r\n      defaultActive:{\r\n          get:function(){\r\n              const { isActive,name,value } = this.activeMenu;\r\n              const { list } = this;\r\n              if(isActive){\r\n                  if(name && value){\r\n                      let index =list.findIndex(item=>item[name]==value);\r\n                      return index == -1?'0':index.toString();\r\n                  }else{\r\n                      return '0'\r\n                  }\r\n              }else{\r\n                  return ''\r\n              }\r\n          }\r\n      },\r\n  },\r\n  watch:{\r\n      dataList:{\r\n          handler:function(){\r\n\r\n          }\r\n      }\r\n  },\r\n  async created() {\r\n    await this.getList();\r\n    const { isActive,name,value } = this.activeMenu;\r\n    const { list } = this;\r\n    if(isActive){\r\n        if(name && value){\r\n            let item =list.find((i)=>i[name]==value);\r\n            this.$emit('select',item ?item:this.list[0])\r\n        }else{\r\n            this.$emit('select',this.list[0])\r\n        }\r\n    }\r\n  },\r\n  methods: {\r\n    /** 查询列表 */\r\n    async getList() {\r\n      this.loading = true;\r\n      if (\r\n        this.fun !== null &&\r\n        typeof this.fun !== 'undefined' &&\r\n        typeof this.fun === 'function'\r\n      ) {\r\n        const { rows, total } = await this.fun(this.queryParams);\r\n        this.list = rows;\r\n        this.total = total;\r\n        this.loading = false;\r\n      }\r\n    },\r\n    handleSelect(index) {\r\n        if(this.isSub){\r\n            let childrenList=[];\r\n            this.list.forEach(item => {\r\n                childrenList = childrenList.concat(item.children);\r\n            });\r\n            this.$emit('select', childrenList.filter(item=>item.channelSipId==index)[0]);\r\n        }else{\r\n            this.$emit('select', this.list[Number(index)]);\r\n        }\r\n    },\r\n    handleInput(value) {\r\n      this.queryParams[this.searchParma] = value;\r\n      this.queryParams.pageNum = 1;\r\n      this.getList();\r\n    },\r\n    handlePagination(e) {\r\n      this.queryParams.pageNum = e;\r\n      this.getList();\r\n    }\r\n  },\r\n};\r\n</script>\r\n<style lang=\"scss\" scoped>\r\n.search-menu {\r\n  &-header {\r\n    height: 70px;\r\n    display: flex;\r\n    align-items: center;\r\n    padding-left: 15px;\r\n  }\r\n  &-body {\r\n    height: calc(100vh - 84px - 70px - 50px - 30px);\r\n    padding: 0px 15px;\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: center;\r\n  }\r\n  &-footer {\r\n    height: 50px;\r\n    text-align: center;\r\n  }\r\n}\r\n::v-deep {\r\n  & .el-menu {\r\n    border-right: none;\r\n    width: 100%;\r\n    margin-top: 10px;\r\n  }\r\n  & .el-menu-item {\r\n    padding-left: 0 !important;\r\n    height: 40px;\r\n    line-height: 40px;\r\n  }\r\n  & .el-submenu__title{\r\n      padding-left: 5px !important;\r\n  }\r\n}\r\n</style>\r\n"]}]}