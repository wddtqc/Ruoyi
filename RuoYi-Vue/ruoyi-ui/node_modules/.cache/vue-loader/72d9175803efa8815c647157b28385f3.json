ACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"index.vue","sourceRoot":"src/views/agriculture/taskEmployee","sourcesContent":["<template>\r\n  <div class=\"app-container-sm\">\r\n      <el-card class=\"card-margin-bottom\">\r\n    <el-form :model=\"queryParams\" ref=\"queryForm\" :inline=\"true\" v-show=\"showSearch\" label-width=\"68px\" class=\"form-minus-bottom\">\r\n      <el-form-item label=\"任务ID\" prop=\"taskId\">\r\n        <el-input\r\n          v-model=\"queryParams.taskId\"\r\n          placeholder=\"请输入任务ID\"\r\n          clearable\r\n          size=\"small\"\r\n          @keyup.enter.native=\"handleQuery\"\r\n        />\r\n      </el-form-item>\r\n      <el-form-item label=\"雇员ID\" prop=\"employeeId\">\r\n        <el-input\r\n          v-model=\"queryParams.employeeId\"\r\n          placeholder=\"请输入雇员ID\"\r\n          clearable\r\n          size=\"small\"\r\n          @keyup.enter.native=\"handleQuery\"\r\n        />\r\n      </el-form-item>\r\n      <el-form-item label=\"排序\" prop=\"orderNum\">\r\n        <el-input\r\n          v-model=\"queryParams.orderNum\"\r\n          placeholder=\"请输入排序\"\r\n          clearable\r\n          size=\"small\"\r\n          @keyup.enter.native=\"handleQuery\"\r\n        />\r\n      </el-form-item>\r\n      <el-form-item>\r\n        <el-button type=\"primary\" icon=\"el-icon-search\" size=\"mini\" @click=\"handleQuery\">搜索</el-button>\r\n        <el-button icon=\"el-icon-refresh\" size=\"mini\" @click=\"resetQuery\">重置</el-button>\r\n      </el-form-item>\r\n        <el-form-item class=\"fr\">\r\n            <el-button\r\n                    type=\"primary\"\r\n                    plain\r\n                    icon=\"el-icon-plus\"\r\n                    size=\"mini\"\r\n                    @click=\"handleAdd\"\r\n                    v-hasPermi=\"['agriculture:taskEmployee:add']\"\r\n            >新增</el-button>\r\n            <el-button\r\n                    type=\"warning\"\r\n                    plain\r\n                    icon=\"el-icon-download\"\r\n                    size=\"mini\"\r\n                    @click=\"handleExport\"\r\n                    v-hasPermi=\"['agriculture:taskEmployee:export']\"\r\n            >导出</el-button>\r\n        </el-form-item>\r\n    </el-form>\r\n      </el-card>\r\n<el-card class=\"card-padding-bottom\">\r\n    <el-table v-loading=\"loading\" :data=\"taskEmployeeList\" >\r\n      <el-table-column label=\"任务ID\" align=\"center\" prop=\"taskId\" />\r\n      <el-table-column label=\"雇员ID\" align=\"center\" prop=\"employeeId\" />\r\n      <el-table-column label=\"备注\" align=\"center\" prop=\"remark\" />\r\n      <el-table-column label=\"状态\" align=\"center\" prop=\"status\" />\r\n      <el-table-column label=\"排序\" align=\"center\" prop=\"orderNum\" />\r\n      <el-table-column label=\"操作\" align=\"center\" class-name=\"small-padding fixed-width\">\r\n        <template slot-scope=\"scope\">\r\n          <el-button\r\n            size=\"mini\"\r\n            type=\"text\"\r\n            icon=\"el-icon-edit\"\r\n            @click=\"handleUpdate(scope.row)\"\r\n            v-hasPermi=\"['agriculture:taskEmployee:edit']\"\r\n          >修改</el-button>\r\n          <el-button\r\n            size=\"mini\"\r\n            type=\"text\"\r\n            icon=\"el-icon-delete\"\r\n            @click=\"handleDelete(scope.row)\"\r\n            v-hasPermi=\"['agriculture:taskEmployee:remove']\"\r\n          >删除</el-button>\r\n        </template>\r\n      </el-table-column>\r\n    </el-table>\r\n\r\n    <pagination\r\n      v-show=\"total>0\"\r\n      :total=\"total\"\r\n      :page.sync=\"queryParams.pageNum\"\r\n      :limit.sync=\"queryParams.pageSize\"\r\n      @pagination=\"getList\"\r\n    />\r\n</el-card>\r\n    <!-- 添加或修改批次任务工人对话框 -->\r\n    <el-dialog :title=\"title\" :visible.sync=\"open\" width=\"500px\" append-to-body>\r\n      <el-form ref=\"form\" :model=\"form\" :rules=\"rules\" label-width=\"80px\">\r\n        <el-form-item label=\"任务ID\" prop=\"taskId\">\r\n          <el-input v-model=\"form.taskId\" placeholder=\"请输入任务ID\" />\r\n        </el-form-item>\r\n        <el-form-item label=\"雇员ID\" prop=\"employeeId\">\r\n          <el-input v-model=\"form.employeeId\" placeholder=\"请输入雇员ID\" />\r\n        </el-form-item>\r\n        <el-form-item label=\"备注\" prop=\"remark\">\r\n          <el-input v-model=\"form.remark\" type=\"textarea\" placeholder=\"请输入内容\" />\r\n        </el-form-item>\r\n        <el-form-item label=\"排序\" prop=\"orderNum\">\r\n          <el-input v-model=\"form.orderNum\" placeholder=\"请输入排序\" />\r\n        </el-form-item>\r\n        <el-form-item label=\"删除标志\" prop=\"delFlag\">\r\n          <el-input v-model=\"form.delFlag\" placeholder=\"请输入删除标志\" />\r\n        </el-form-item>\r\n      </el-form>\r\n      <div slot=\"footer\" class=\"dialog-footer\">\r\n        <el-button type=\"primary\" @click=\"submitForm\">确 定</el-button>\r\n        <el-button @click=\"cancel\">取 消</el-button>\r\n      </div>\r\n    </el-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { listTaskEmployee, getTaskEmployee, delTaskEmployee, addTaskEmployee, updateTaskEmployee } from \"@/api/system/taskEmployee\";\r\n\r\nexport default {\r\n  name: \"TaskEmployee\",\r\n  data() {\r\n    return {\r\n      // 遮罩层\r\n      loading: true,\r\n      // 选中数组\r\n      ids: [],\r\n      // 非单个禁用\r\n      single: true,\r\n      // 非多个禁用\r\n      multiple: true,\r\n      // 显示搜索条件\r\n      showSearch: true,\r\n      // 总条数\r\n      total: 0,\r\n      // 批次任务工人表格数据\r\n      taskEmployeeList: [],\r\n      // 弹出层标题\r\n      title: \"\",\r\n      // 是否显示弹出层\r\n      open: false,\r\n      // 查询参数\r\n      queryParams: {\r\n        pageNum: 1,\r\n        pageSize: 10,\r\n        taskId: null,\r\n        employeeId: null,\r\n        status: null,\r\n        orderNum: null,\r\n      },\r\n      // 表单参数\r\n      form: {},\r\n      // 表单校验\r\n      rules: {\r\n        taskId: [\r\n          { required: true, message: \"任务ID不能为空\", trigger: \"blur\" }\r\n        ],\r\n        employeeId: [\r\n          { required: true, message: \"雇员ID不能为空\", trigger: \"blur\" }\r\n        ],\r\n        remark: [\r\n          { required: true, message: \"备注不能为空\", trigger: \"blur\" }\r\n        ],\r\n        status: [\r\n          { required: true, message: \"状态不能为空\", trigger: \"blur\" }\r\n        ],\r\n        orderNum: [\r\n          { required: true, message: \"排序不能为空\", trigger: \"blur\" }\r\n        ],\r\n      }\r\n    };\r\n  },\r\n  created() {\r\n    this.getList();\r\n  },\r\n  methods: {\r\n    /** 查询批次任务工人列表 */\r\n    getList() {\r\n      this.loading = true;\r\n      listTaskEmployee(this.queryParams).then(response => {\r\n        this.taskEmployeeList = response.rows;\r\n        this.total = response.total;\r\n        this.loading = false;\r\n      });\r\n    },\r\n    // 取消按钮\r\n    cancel() {\r\n      this.open = false;\r\n      this.reset();\r\n    },\r\n    // 表单重置\r\n    reset() {\r\n      this.form = {\r\n        id: null,\r\n        taskId: null,\r\n        employeeId: null,\r\n        remark: null,\r\n        status: \"0\",\r\n        orderNum: null,\r\n        createBy: null,\r\n        createTime: null,\r\n        updateBy: null,\r\n        updateTime: null,\r\n        delFlag: null\r\n      };\r\n      this.resetForm(\"form\");\r\n    },\r\n    /** 搜索按钮操作 */\r\n    handleQuery() {\r\n      this.queryParams.pageNum = 1;\r\n      this.getList();\r\n    },\r\n    /** 重置按钮操作 */\r\n    resetQuery() {\r\n      this.resetForm(\"queryForm\");\r\n      this.handleQuery();\r\n    },\r\n    /** 新增按钮操作 */\r\n    handleAdd() {\r\n      this.reset();\r\n      this.open = true;\r\n      this.title = \"添加批次任务工人\";\r\n    },\r\n    /** 修改按钮操作 */\r\n    handleUpdate(row) {\r\n      this.reset();\r\n      const id = row.id || this.ids\r\n      getTaskEmployee(id).then(response => {\r\n        this.form = response.data;\r\n        this.open = true;\r\n        this.title = \"修改批次任务工人\";\r\n      });\r\n    },\r\n    /** 提交按钮 */\r\n    submitForm() {\r\n      this.$refs[\"form\"].validate(valid => {\r\n        if (valid) {\r\n          if (this.form.id != null) {\r\n            updateTaskEmployee(this.form).then(response => {\r\n              this.$modal.msgSuccess(\"修改成功\");\r\n              this.open = false;\r\n              this.getList();\r\n            });\r\n          } else {\r\n            addTaskEmployee(this.form).then(response => {\r\n              this.$modal.msgSuccess(\"新增成功\");\r\n              this.open = false;\r\n              this.getList();\r\n            });\r\n          }\r\n        }\r\n      });\r\n    },\r\n    /** 删除按钮操作 */\r\n    handleDelete(row) {\r\n      const ids = row.id || this.ids;\r\n      this.$modal.confirm('是否确认删除批次任务工人编号为\"' + ids + '\"的数据项？').then(function() {\r\n        return delTaskEmployee(ids);\r\n      }).then(() => {\r\n        this.getList();\r\n        this.$modal.msgSuccess(\"删除成功\");\r\n      }).catch(() => {});\r\n    },\r\n    /** 导出按钮操作 */\r\n    handleExport() {\r\n      this.download('agriculture/taskEmployee/export', {\r\n        ...this.queryParams\r\n      }, `taskEmployee_${new Date().getTime()}.xlsx`)\r\n    }\r\n  }\r\n};\r\n</script>\r\n"]}]}