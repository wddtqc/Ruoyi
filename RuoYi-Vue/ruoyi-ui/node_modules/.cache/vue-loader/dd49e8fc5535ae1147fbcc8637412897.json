plate>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"DataTag\",\r\n  props: {\r\n    options: {\r\n      type: Array,\r\n      default: null,\r\n    },\r\n    value: [Number, String, Array],\r\n    // notag:无标签样式 空：主题色 success：绿色 info：灰色 warning：黄色 danger：红色\r\n    type:{\r\n      type:String,\r\n      default:'notag'\r\n    },\r\n    valueName:[String],\r\n    labelName:[String]\r\n  },\r\n  computed: {\r\n    values() {\r\n      if (this.value !== null && typeof this.value !== 'undefined') {\r\n        return Array.isArray(this.value) ? this.value : [String(this.value)];\r\n      } else {\r\n        return [];\r\n      }\r\n    },\r\n    dataList(){\r\n      if(this.options !== null && typeof this.options !== 'undefined' && Array.isArray(this.options)){\r\n        return this.options.map(item=>({label:item[this.labelName],value:String(item[this.valueName])}));\r\n      }else{\r\n        return [];\r\n      }\r\n    }\r\n  },\r\n};\r\n</script>\r\n<style scoped>\r\n.el-tag + .el-tag {\r\n  margin-left: 10px;\r\n}\r\n</style>\r\n"]}]}