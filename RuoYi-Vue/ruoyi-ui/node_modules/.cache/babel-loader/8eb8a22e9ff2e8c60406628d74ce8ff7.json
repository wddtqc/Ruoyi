{"remainingRequest":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\node_modules\\babel-loader\\lib\\index.js!D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\node_modules\\cache-loader\\dist\\cjs.js??ref--0-0!D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\src\\views\\iot\\sip\\sipid-dialog.vue?vue&type=script&lang=js","dependencies":[{"path":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\src\\views\\iot\\sip\\sipid-dialog.vue","mtime":1780922369613},{"path":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\babel.config.js","mtime":1780922369473},{"path":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1781061437342},{"path":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\node_modules\\babel-loader\\lib\\index.js","mtime":1781061438494},{"path":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1781061437342},{"path":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\node_modules\\vue-loader\\lib\\index.js","mtime":1781061438994}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["_elementChinaAreaData","require","_channel","name","dicts","props","product","type","Object","default","data","loading","title","total","open","devsipid","createForm","city","deviceType","channelType","createNum","cityOptions","regionData","cityCode","created","methods","changeProvince","str","CodeToText","citycode","submitForm","_this","$modal","alertError","productId","productName","tenantId","tenantName","deviceSipId","channelSipId","length","addChannel","then","response","msgSuccess","confirmSelectProduct","$message","message","$emit","closeDialog"],"sources":["src/views/iot/sip/sipid-dialog.vue"],"sourcesContent":["<template>\r\n<el-dialog :title=\"title\" :visible.sync=\"open\" width=\"400px\" append-to-body>\r\n    <el-form ref=\"createForm\" :model=\"createForm\" label-width=\"100px\">\r\n        <el-form-item label=\"行政区划\">\r\n            <el-cascader :options=\"cityOptions\" v-model=\"createForm.city\" @change=\"changeProvince\" change-on-select>\r\n            </el-cascader>\r\n        </el-form-item>\r\n        <el-form-item label=\"设备类型\" prop=\"deviceType\">\r\n            <el-select v-model=\"createForm.deviceType\" placeholder=\"请选择设备类型\">\r\n                <el-option v-for=\"dict in dict.type.video_type\" :key=\"dict.value\" :label=\"dict.label\" :value=\"dict.value\"></el-option>\r\n            </el-select>\r\n        </el-form-item>\r\n        <el-form-item label=\"通道类型\" prop=\"channelType\">\r\n            <el-select v-model=\"createForm.channelType\" placeholder=\"请选择设备类型\">\r\n                <el-option v-for=\"dict in dict.type.channel_type\" :key=\"dict.value\" :label=\"dict.label\" :value=\"dict.value\"></el-option>\r\n            </el-select>\r\n        </el-form-item>\r\n        <el-form-item label=\"通道数量\" prop=\"createNum\">\r\n            <el-input-number controls-position=\"right\" v-model=\"createForm.createNum\" placeholder=\"请输入生成通道数量\" type=\"number\" style=\"width:220px;\" />\r\n        </el-form-item>\r\n    </el-form>\r\n    <div slot=\"footer\" class=\"dialog-footer\">\r\n        <el-button type=\"primary\" @click=\"submitForm\">生 成</el-button>\r\n        <el-button @click=\"closeDialog\">取 消</el-button>\r\n    </div>\r\n</el-dialog>\r\n</template>\r\n\r\n<script>\r\nimport {\r\n    provinceAndCityData,\r\n    regionData,\r\n    provinceAndCityDataPlus,\r\n    regionDataPlus,\r\n    CodeToText,\r\n    TextToCode\r\n} from 'element-china-area-data'\r\n\r\nimport {addChannel} from \"@/api/iot/channel\";\r\n\r\nexport default {\r\n    name: \"sipid-dialog\",\r\n    dicts: ['video_type', 'channel_type'],\r\n    props: {\r\n        product: {\r\n            type: Object,\r\n            default: null\r\n        }\r\n    },\r\n    data() {\r\n        return {\r\n            // 遮罩层\r\n            loading: true,\r\n            title: \"生成设备编号和通道\",\r\n            // 总条数\r\n            total: 0,\r\n            // 打开选择产品对话框\r\n            open: false,\r\n            devsipid: \"\",\r\n            createForm: {\r\n                city: '',\r\n                deviceType: '',\r\n                channelType: '',\r\n                createNum: 1,\r\n            },\r\n            // 城市\r\n            cityOptions: regionData,\r\n            city: '',\r\n            cityCode: '',\r\n        };\r\n    },\r\n    created() {\r\n\r\n    },\r\n    methods: {\r\n        /** 行政区划改变 **/\r\n        changeProvince(data) {\r\n            if (data && data[0] != null && data[1] != null && data[2] != null) {\r\n                const str = CodeToText[data[0]] + '/' + CodeToText[data[1]] + '/' + CodeToText[data[2]];\r\n                this.createForm.citycode = str;\r\n            }\r\n        },\r\n        /** 提交按钮 */\r\n        submitForm() {\r\n            if (this.createForm.createNum < 1) {\r\n                this.$modal.alertError(\"通道数量至少一个\");\r\n                return;\r\n            }\r\n            this.createForm.productId = this.product.productId;\r\n            this.createForm.productName = this.product.productName;\r\n            this.createForm.tenantId = this.product.tenantId;\r\n            this.createForm.tenantName = this.product.tenantName;\r\n            this.createForm.deviceSipId = this.createForm.city[2] + \"0000\" + this.createForm.deviceType + \"0\"\r\n            this.createForm.channelSipId = this.createForm.city[2] + \"0000\" + this.createForm.channelType + \"0\"\r\n            if (this.createForm.deviceType !== \"\" && this.createForm.channelType !== \"\" && this.createForm.city.length === 3) {\r\n              addChannel(this.createForm.createNum, this.createForm).then(response => {\r\n                    this.$modal.msgSuccess(\"已生成设备编号和通道\");\r\n                    this.devsipid = response.data;\r\n                    this.confirmSelectProduct();\r\n                });\r\n            } else {\r\n                this.$message({\r\n                    type: 'error',\r\n                    message: '请选择地区，设备类型，通道类型！！'\r\n                });\r\n            }\r\n\r\n        },\r\n        confirmSelectProduct() {\r\n            this.open = false;\r\n            this.$emit('addGenEvent', this.devsipid);\r\n        },\r\n        /**关闭对话框 */\r\n        closeDialog() {\r\n            this.open = false;\r\n        }\r\n    }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n\r\n</style>\r\n"],"mappings":";;;;;;AA6BA,IAAAA,qBAAA,GAAAC,OAAA;AASA,IAAAC,QAAA,GAAAD,OAAA;;;;;;;;;;;;;;;;;;;;;;;;;;;;;iCAEA;EACAE,IAAA;EACAC,KAAA;EACAC,KAAA;IACAC,OAAA;MACAC,IAAA,EAAAC,MAAA;MACAC,OAAA;IACA;EACA;EACAC,IAAA,WAAAA,KAAA;IACA;MACA;MACAC,OAAA;MACAC,KAAA;MACA;MACAC,KAAA;MACA;MACAC,IAAA;MACAC,QAAA;MACAC,UAAA;QACAC,IAAA;QACAC,UAAA;QACAC,WAAA;QACAC,SAAA;MACA;MACA;MACAC,WAAA,EAAAC,gCAAA;MACAL,IAAA;MACAM,QAAA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA,GAEA;EACAC,OAAA;IACA,cACAC,cAAA,WAAAA,eAAAhB,IAAA;MACA,IAAAA,IAAA,IAAAA,IAAA,eAAAA,IAAA,eAAAA,IAAA;QACA,IAAAiB,GAAA,GAAAC,gCAAA,CAAAlB,IAAA,aAAAkB,gCAAA,CAAAlB,IAAA,aAAAkB,gCAAA,CAAAlB,IAAA;QACA,KAAAM,UAAA,CAAAa,QAAA,GAAAF,GAAA;MACA;IACA;IACA,WACAG,UAAA,WAAAA,WAAA;MAAA,IAAAC,KAAA;MACA,SAAAf,UAAA,CAAAI,SAAA;QACA,KAAAY,MAAA,CAAAC,UAAA;QACA;MACA;MACA,KAAAjB,UAAA,CAAAkB,SAAA,QAAA5B,OAAA,CAAA4B,SAAA;MACA,KAAAlB,UAAA,CAAAmB,WAAA,QAAA7B,OAAA,CAAA6B,WAAA;MACA,KAAAnB,UAAA,CAAAoB,QAAA,QAAA9B,OAAA,CAAA8B,QAAA;MACA,KAAApB,UAAA,CAAAqB,UAAA,QAAA/B,OAAA,CAAA+B,UAAA;MACA,KAAArB,UAAA,CAAAsB,WAAA,QAAAtB,UAAA,CAAAC,IAAA,oBAAAD,UAAA,CAAAE,UAAA;MACA,KAAAF,UAAA,CAAAuB,YAAA,QAAAvB,UAAA,CAAAC,IAAA,oBAAAD,UAAA,CAAAG,WAAA;MACA,SAAAH,UAAA,CAAAE,UAAA,gBAAAF,UAAA,CAAAG,WAAA,gBAAAH,UAAA