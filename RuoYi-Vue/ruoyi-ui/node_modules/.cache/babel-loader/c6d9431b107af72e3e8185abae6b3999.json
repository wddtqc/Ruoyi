>\r\n    <el-divider></el-divider>\r\n    <el-form :model=\"queryParams\" ref=\"product-select-template\" :inline=\"true\" label-width=\"48px\">\r\n        <el-form-item label=\"名称\" prop=\"templateName\">\r\n            <el-input v-model=\"queryParams.templateName\" placeholder=\"请输入物模型名称\" clearable size=\"small\" @keyup.enter.native=\"handleQuery\" />\r\n        </el-form-item>\r\n        <el-form-item label=\"类别\" prop=\"type\">\r\n            <el-select v-model=\"queryParams.type\" placeholder=\"请选择模型类别\" clearable size=\"small\">\r\n                <el-option v-for=\"dict in dict.type.iot_things_type\" :key=\"dict.value\" :label=\"dict.label\" :value=\"dict.value\" />\r\n            </el-select>\r\n        </el-form-item>\r\n        <el-form-item>\r\n            <el-button type=\"primary\" icon=\"el-icon-search\" size=\"mini\" @click=\"handleQuery\">搜索</el-button>\r\n            <el-button icon=\"el-icon-refresh\" size=\"mini\" @click=\"resetQuery\">重置</el-button>\r\n        </el-form-item>\r\n    </el-form>\r\n\r\n    <el-table v-loading=\"loading\" :data=\"templateList\" @selection-change=\"handleSelectionChange\" ref=\"selectTemplateTable\" size=\"small\">\r\n        <el-table-column type=\"selection\" width=\"55\" align=\"center\" />\r\n        <el-table-column label=\"名称\" align=\"center\" prop=\"templateName\" />\r\n        <el-table-column label=\"标识符\" align=\"center\" prop=\"identifier\" />\r\n        <el-table-column label=\"物模型类别\" align=\"center\" prop=\"type\">\r\n            <template slot-scope=\"scope\">\r\n                <dict-tag :options=\"dict.type.iot_things_type\" :value=\"scope.row.type\" />\r\n            </template>\r\n        </el-table-column>\r\n        <el-table-column label=\"监测值\" align=\"center\" prop=\"isMonitor\">\r\n            <template slot-scope=\"scope\">\r\n                <dict-tag :options=\"dict.type.iot_yes_no\" :value=\"scope.row.isMonitor\" />\r\n            </template>\r\n        </el-table-column>\r\n        <el-table-column label=\"数据类型\" align=\"center\" prop=\"datatype\">\r\n            <template slot-scope=\"scope\">\r\n                <dict-tag :options=\"dict.type.iot_data_type\" :value=\"scope.row.datatype\" />\r\n            </template>\r\n        </el-table-column>\r\n    </el-table>\r\n\r\n    <pagination v-show=\"total > 0\" :total=\"total\" :page.sync=\"queryParams.pageNum\" :limit.sync=\"queryParams.pageSize\" @pagination=\"getList\" />\r\n</div>\r\n</template>\r\n\r\n<script>\r\nimport {\r\n    listTemplate,\r\n} from \"@/api/iot/template\";\r\nexport default {\r\n    name: \"product-select-template\",\r\n    dicts: [\"iot_things_type\", \"iot_data_type\", \"iot_yes_no\"],\r\n    data() {\r\n        return {\r\n            // 选中数组\r\n            ids: [],\r\n            // 非单个禁用\r\n            single: true,\r\n            // 非多个禁用\r\n            multiple: true,\r\n            // 总条数\r\n            total: 0,\r\n            // 通用物模型表格数据\r\n            templateList: [],\r\n            // 查询参数\r\n            queryParams: {\r\n                pageNum: 1,\r\n                pageSize: 10,\r\n                templateName: null,\r\n                type: null,\r\n            },\r\n        };\r\n    },\r\n    created() {\r\n        this.getList();\r\n        this.ids = [];\r\n    },\r\n    methods: {\r\n        /** 查询通用物模型列表 */\r\n        getList() {\r\n            this.loading = true;\r\n            listTemplate(this.queryParams).then((response) => {\r\n                this.templateList = response.rows;\r\n                this.total = response.total;\r\n                this.loading = false;\r\n            });\r\n        },\r\n        /** 搜索按钮操作 */\r\n        handleQuery() {\r\n            this.queryParams.pageNum = 1;\r\n            this.getList();\r\n        },\r\n        /** 重置按钮操作 */\r\n        resetQuery() {\r\n            this.resetForm(\"queryForm\");\r\n            this.handleQuery();\r\n        },\r\n        // 多选框选中数据\r\n        handleSelectionChange(selection) {\r\n            this.ids = selection.map((item) => item.templateId);\r\n            this.single = selection.length !== 1;\r\n            this.multiple = !selection.length;\r\n            // Id数组传递到父组件\r\n            this.$emit('idsToParentEvent', this.ids)\r\n        },\r\n\r\n    },\r\n};\r\n</script>\r\n"],"mappings":";;;;;;;;;;AA4CA,IAAAA,SAAA,GAAAC,OAAA;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;iCAGA;EACAC,IAAA;EACAC,KAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACA;MACAC,GAAA;MACA;MACAC,MAAA;MACA;MACAC,QAAA;MACA;MACAC,KAAA;MACA;MACAC,YAAA;MACA;MACAC,WAAA;QACAC,OAAA;QACAC,QAAA;QACAC,YAAA;QACAC,IAAA;MACA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA;IACA,KAAAC,OAAA;IACA,KAAAX,GAAA;EACA;EACAY,OAAA;IACA,gBACAD,OAAA,WAAAA,QAAA;MAAA,IAAAE,KAAA;MACA,KAAAC,OAAA;MACA,IAAAC,sBAAA,OAAAV,WAAA,EAAAW,IAAA,WAAAC,QAAA;QACAJ,KAAA,CAAAT,YAAA,GAAAa,QAAA,CAAAC,IAAA;QACAL,KAAA,CAAAV,KAAA,GAAAc,QAAA,CAAAd,KAAA;QACAU,KAAA,CAAAC,OAAA;MACA;IACA;IACA,aACAK,WAAA,WAAAA,YAAA;MACA,KAAAd,WAAA,CAAAC,OAAA;MACA,KAAAK,OAAA;IACA;IACA,aACAS,UAAA,WAAAA,WAAA;MACA,KAAAC,SAAA;MACA,KAAAF,WAAA;IACA;IACA;IACAG,qBAAA,WAAAA,sBAAAC,SAAA;MACA,KAAAvB,GAAA,GAAAuB,SAAA,CAAAC,GAAA,WAAAC,IAAA;QAAA,OAAAA,IAAA,CAAAC,UAAA;MAAA;MACA,KAAAzB,MAAA,GAAAsB,SAAA,CAAAI,MAAA;MACA,KAAAzB,QAAA,IAAAqB,SAAA,CAAAI,MAAA;MACA;MACA,KAAAC,KAAA,0BAAA5B,GAAA;IACA;EAEA;AACA","ignoreList":[]}]}