sg","dangerouslyUseHTMLString","$emit","handleSubmit","files","uploadFiles","length","$modal","msgError","name","toLowerCase","endsWith","submit"],"sources":["src/components/ExcelImportDialog/index.vue"],"sourcesContent":["<template>\r\n  <el-dialog :title=\"title\" :visible.sync=\"visible\" :width=\"width\" append-to-body @close=\"handleClose\">\r\n    <el-upload ref=\"uploadRef\" :limit=\"1\" accept=\".xlsx, .xls\" :headers=\"headers\" :action=\"uploadUrl\" :disabled=\"isUploading\" :on-progress=\"handleProgress\" :on-success=\"handleSuccess\" :auto-upload=\"false\" drag>\r\n      <i class=\"el-icon-upload\"></i>\r\n      <div class=\"el-upload__text\">将文件拖到此处，或<em>点击上传</em></div>\r\n      <div class=\"el-upload__tip text-center\" slot=\"tip\">\r\n        <div class=\"el-upload__tip\" slot=\"tip\">\r\n          <el-checkbox v-model=\"updateSupport\"> {{ updateSupportLabel }} </el-checkbox>\r\n        </div>\r\n        <span>仅允许导入xls、xlsx格式文件。</span>\r\n        <el-link v-if=\"templateUrl\" type=\"primary\" :underline=\"false\" style=\"font-size: 12px; vertical-align: baseline\" @click=\"handleDownloadTemplate\">下载模板</el-link>\r\n      </div>\r\n    </el-upload>\r\n    <div slot=\"footer\" class=\"dialog-footer\">\r\n      <el-button type=\"primary\" @click=\"handleSubmit\">确 定</el-button>\r\n      <el-button @click=\"visible = false\">取 消</el-button>\r\n    </div>\r\n  </el-dialog>\r\n</template>\r\n\r\n<script>\r\nimport { getToken } from '@/utils/auth'\r\n\r\nexport default {\r\n  props: {\r\n    // 对话框标题\r\n    title: {\r\n      type: String,\r\n      default: '数据导入'\r\n    },\r\n    // 对话框宽度\r\n    width: {\r\n      type: String,\r\n      default: '400px'\r\n    },\r\n    // 上传接口地址（必传）\r\n    action: {\r\n      type: String,\r\n      required: true\r\n    },\r\n    // 模板下载接口地址，不传则不显示下载模板链接\r\n    templateAction: {\r\n      type: String,\r\n      default: ''\r\n    },\r\n    // 模板文件名\r\n    templateFileName: {\r\n      type: String,\r\n      default: 'template'\r\n    },\r\n    // 覆盖更新勾选框的说明文字\r\n    updateSupportLabel: {\r\n      type: String,\r\n      default: '是否更新已经存在的数据'\r\n    }\r\n  },\r\n  data() {\r\n    return {\r\n      visible: false,\r\n      isUploading: false,\r\n      updateSupport: false,\r\n      headers: { Authorization: 'Bearer ' + getToken() }\r\n    }\r\n  },\r\n  computed: {\r\n    uploadUrl() {\r\n      return process.env.VUE_APP_BASE_API + this.action + '?updateSupport=' + (this.updateSupport ? 1 : 0)\r\n    },\r\n    templateUrl() {\r\n      return !!this.templateAction\r\n    }\r\n  },\r\n  methods: {\r\n    // 打开对话框（供父组件通过 ref 调用）\r\n    open() {\r\n      this.updateSupport = false\r\n      this.isUploading = false\r\n      this.visible = true\r\n      this.$nextTick(() => {\r\n        if (this.$refs.uploadRef) {\r\n          this.$refs.uploadRef.clearFiles()\r\n        }\r\n      })\r\n    },\r\n    // 关闭时清理\r\n    handleClose() {\r\n      this.isUploading = false\r\n      if (this.$refs.uploadRef) {\r\n        this.$refs.uploadRef.clearFiles()\r\n      }\r\n    },\r\n    // 下载模板\r\n    handleDownloadTemplate() {\r\n      this.download(this.templateAction, {}, `${this.templateFileName}_${new Date().getTime()}.xlsx`)\r\n    },\r\n    // 上传进度\r\n    handleProgress() {\r\n      this.isUploading = true\r\n    },\r\n    // 上传成功\r\n    handleSuccess(response) {\r\n      this.visible = false\r\n      this.isUploading = false\r\n      if (this.$refs.uploadRef) {\r\n        this.$refs.uploadRef.clearFiles()\r\n      }\r\n      this.$alert(\"<div style='overflow:auto;overflow-x:hidden;max-height:70vh;padding:10px 20px 0;'>\" + response.msg + '</div>', '导入结果', { dangerouslyUseHTMLString: true })\r\n      this.$emit('success')\r\n    },\r\n    // 提交上传\r\n    handleSubmit() {\r\n      const files = this.$refs.uploadRef.uploadFiles\r\n      if (!files || files.length === 0) {\r\n        this.$modal.msgError('请选择要上传的文件。')\r\n        return\r\n      }\r\n      const name = files[0].name.toLowerCase()\r\n      if (!name.endsWith('.xls') && !name.endsWith('.xlsx')) {\r\n        this.$modal.msgError('请选择后缀为 \"xls\" 或 \"xlsx\" 的文件。')\r\n        return\r\n      }\r\n      this.$refs.uploadRef.submit()\r\n    }\r\n  }\r\n}\r\n</script>\r\n"],"mappings":";;;;;;;;;AAqBA,IAAAA,KAAA,GAAAC,OAAA;;;;;;;;;;;;;;;;;;;;;iCAEA;EACAC,KAAA;IACA;IACAC,KAAA;MACAC,IAAA,EAAAC,MAAA;MACAC,OAAA;IACA;IACA;IACAC,KAAA;MACAH,IAAA,EAAAC,MAAA;MACAC,OAAA;IACA;IACA;IACAE,MAAA;MACAJ,IAAA,EAAAC,MAAA;MACAI,QAAA;IACA;IACA;IACAC,cAAA;MACAN,IAAA,EAAAC,MAAA;MACAC,OAAA;IACA;IACA;IACAK,gBAAA;MACAP,IAAA,EAAAC,MAAA;MACAC,OAAA;IACA;IACA;IACAM,kBAAA;MACAR,IAAA,EAAAC,MAAA;MACAC,OAAA;IACA;EACA;EACAO,IAAA,WAAAA,KAAA;IACA;MACAC,OAAA;MACAC,WAAA;MACAC,aAAA;MACAC,OAAA;QAAAC,aAAA,kBAAAC,cAAA;MAAA;IACA;EACA;EACAC,QAAA;IACAC,SAAA,WAAAA,UAAA;MACA,OAAAC,OAAA,CAAAC,GAAA,CAAAC,gBAAA,QAAAhB,MAAA,6BAAAQ,aAAA;IACA;IACAS,WAAA,WAAAA,YAAA;MACA,cAAAf,cAAA;IACA;EACA;EACAgB,OAAA;IACA;IACAC,IAAA,WAAAA,KAAA;MAAA,IAAAC,KAAA;MACA,KAAAZ,aAAA;MACA,KAAAD,WAAA;MACA,KAAAD,OAAA;MACA,KAAAe,SAAA;QACA,IAAAD,KAAA,CAAAE,KAAA,CAAAC,SAAA;UACAH,KAAA,CAAAE,KAAA,CAAAC,SAAA,CAAAC,UAAA;QACA;MACA;IACA;IACA;IACAC,WAAA,WAAAA,YAAA;MACA,KAAAlB,WAAA;MACA,SAAAe,KAAA,CAAAC,SAAA;QACA,KAAAD,KAAA,CAAAC,SAAA,CAAAC,UAAA;MACA;IACA;IACA;IACAE,sBAAA,WAAAA,uBAAA;MACA,KAAAC,QAAA,MAAAzB,cAAA,SAAA0B,MAAA,MAAAzB,gBAAA,OAAAyB,MAAA,KAAAC,IAAA,GAAAC,OAAA;IACA;IACA;IACAC,cAAA,WAAAA,eAAA;MACA,KAAAxB,WAAA;IACA;IACA;IACAyB,aAAA,WAAAA,cAAAC,QAAA;MACA,KAAA3B,OAAA;MACA,KAAAC,WAAA;MACA,SAAAe,KAAA,CAAAC,SAAA;QACA,KAAAD,KAAA,CAAAC,SAAA,CAAAC,UAAA;MACA;MACA,KAAAU,MAAA,wFAAAD,QAAA,CAAAE,GAAA;QAAAC,wBAAA;MAAA;MACA,KAAAC,KAAA;IACA;IACA;IACAC,YAAA,WAAAA,aAAA;MACA,IAAAC,KAAA,QAAAjB,KAAA,CAAAC,SAAA,CAAAiB,WAAA;MACA,KAAAD,KAAA,IAAAA,KAAA,CAAAE,MAAA;QACA,KAAAC,MAAA,CAAAC,QAAA;QACA;MACA;MACA,IAAAC,IAAA,GAAAL,KAAA,IAAAK,IAAA,CAAAC,WAAA;MACA,KAAAD,IAAA,CAAAE,QAAA,aAAAF,IAAA,CAAAE,QAAA;QACA,KAAAJ,MAAA,CAAAC,QAAA;QACA;MACA;MACA,KAAArB,KAAA,CAAAC,SAAA,CAAAwB,MAAA;IACA;EACA;AACA","ignoreList":[]}]}