{"remainingRequest":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\node_modules\\babel-loader\\lib\\index.js!D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\node_modules\\cache-loader\\dist\\cjs.js??ref--0-0!D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\src\\views\\agriculture\\germplasm\\components\\task\\index.vue?vue&type=script&lang=js","dependencies":[{"path":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\src\\views\\agriculture\\germplasm\\components\\task\\index.vue","mtime":1781403756864},{"path":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\babel.config.js","mtime":1780922369473},{"path":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1781061437342},{"path":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\node_modules\\babel-loader\\lib\\index.js","mtime":1781061438494},{"path":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1781061437342},{"path":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\node_modules\\vue-loader\\lib\\index.js","mtime":1781061438994}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["_task","require","_user","name","dicts","props","batchId","type","String","default","batchHead","Number","tableBorder","Boolean","data","uploadAction","loading","ids","single","multiple","showSearch","total","taskList","userList","title","open","queryParams","pageNum","pageSize","taskHead","taskName","planStart","planFinish","actualStart","actualFinish","taskDetail","taskImages","taskVideos","status","orderNum","form","rules","required","message","trigger","remark","createBy","delFlag","created","getUserList","getList","methods","_this","listUser","then","response","rows","_this2","listTask","cancel","reset","taskId","createTime","updateBy","updateTime","resetForm","handleQuery","resetQuery","handleSelectionChange","selection","map","item","length","handleAdd","handleUpdate","row","_this3","Promise","all","getTask","_ref","_ref2","_slicedToArray2","_","taskRes","toNumber","catch","err","$modal","msgError","value","num","isNaN","submitForm","_this4","$refs","validate","valid","updateTask","msgSuccess","addTask","handleDelete","_this5","taskIds","confirm","delTask","handleExport","download","_objectSpread2","concat","Date","getTime"],"sources":["src/views/agriculture/germplasm/components/task/index.vue"],"sourcesContent":["<template>\r\n  <div class=\"app-container\">\r\n    <el-form :model=\"queryParams\" ref=\"queryForm\" size=\"small\" :inline=\"true\" v-show=\"showSearch\" label-width=\"68px\">\r\n      <el-form-item label=\"任务名称\" prop=\"taskName\">\r\n        <el-input\r\n          v-model=\"queryParams.taskName\"\r\n          placeholder=\"请输入任务名称\"\r\n          clearable\r\n          @keyup.enter.native=\"handleQuery\"\r\n        />\r\n      </el-form-item>\r\n      <el-form-item label=\"计划开始日期\" prop=\"planStart\">\r\n        <el-date-picker clearable\r\n          v-model=\"queryParams.planStart\"\r\n          type=\"date\"\r\n          value-format=\"yyyy-MM-dd\"\r\n          placeholder=\"请选择计划开始日期\">\r\n        </el-date-picker>\r\n      </el-form-item>\r\n      <el-form-item label=\"计划结束日期\" prop=\"planFinish\">\r\n        <el-date-picker clearable\r\n          v-model=\"queryParams.planFinish\"\r\n          type=\"date\"\r\n          value-format=\"yyyy-MM-dd\"\r\n          placeholder=\"请选择计划结束日期\">\r\n        </el-date-picker>\r\n      </el-form-item>\r\n      <el-form-item label=\"实际开始日期\" prop=\"actualStart\">\r\n        <el-date-picker clearable\r\n          v-model=\"queryParams.actualStart\"\r\n          type=\"date\"\r\n          value-format=\"yyyy-MM-dd\"\r\n          placeholder=\"请选择实际开始日期\">\r\n        </el-date-picker>\r\n      </el-form-item>\r\n      <el-form-item label=\"实际结束日期\" prop=\"actualFinish\">\r\n        <el-date-picker clearable\r\n          v-model=\"queryParams.actualFinish\"\r\n          type=\"date\"\r\n          value-format=\"yyyy-MM-dd\"\r\n          placeholder=\"请选择实际结束日期\">\r\n        </el-date-picker>\r\n      </el-form-item>\r\n      <el-form-item label=\"排序\" prop=\"orderNum\">\r\n        <el-input\r\n          v-model=\"queryParams.orderNum\"\r\n          placeholder=\"请输入排序\"\r\n          clearable\r\n          @keyup.enter.native=\"handleQuery\"\r\n        />\r\n      </el-form-item>\r\n      <el-form-item>\r\n        <el-button type=\"primary\" icon=\"el-icon-search\" size=\"mini\" @click=\"handleQuery\">搜索</el-button>\r\n        <el-button icon=\"el-icon-refresh\" size=\"mini\" @click=\"resetQuery\">重置</el-button>\r\n      </el-form-item>\r\n    </el-form>\r\n\r\n    <el-row :gutter=\"10\" class=\"mb8\">\r\n      <el-col :span=\"1.5\">\r\n        <el-button\r\n          type=\"primary\"\r\n          plain\r\n          icon=\"el-icon-plus\"\r\n          size=\"mini\"\r\n          @click=\"handleAdd\"\r\n          v-hasPermi=\"['system:task:add']\"\r\n        >新增</el-button>\r\n      </el-col>\r\n      <el-col :span=\"1.5\">\r\n        <el-button\r\n          type=\"success\"\r\n          plain\r\n          icon=\"el-icon-edit\"\r\n          size=\"mini\"\r\n          :disabled=\"single\"\r\n          @click=\"handleUpdate\"\r\n          v-hasPermi=\"['system:task:edit']\"\r\n        >修改</el-button>\r\n      </el-col>\r\n      <el-col :span=\"1.5\">\r\n        <el-button\r\n          type=\"danger\"\r\n          plain\r\n          icon=\"el-icon-delete\"\r\n          size=\"mini\"\r\n          :disabled=\"multiple\"\r\n          @click=\"handleDelete\"\r\n          v-hasPermi=\"['system:task:remove']\"\r\n        >删除</el-button>\r\n      </el-col>\r\n      <el-col :span=\"1.5\">\r\n        <el-button\r\n          type=\"warning\"\r\n          plain\r\n          icon=\"el-icon-download\"\r\n          size=\"mini\"\r\n          @click=\"handleExport\"\r\n          v-hasPermi=\"['system:task:export']\"\r\n        >导出</el-button>\r\n      </el-col>\r\n      <right-toolbar :showSearch.sync=\"showSearch\" @queryTable=\"getList\"></right-toolbar>\r\n    </el-row>\r\n\r\n    <el-table v-loading=\"loading\" :data=\"taskList\" @selection-change=\"handleSelectionChange\">\r\n      <el-table-column type=\"selection\" width=\"55\" align=\"center\" />\r\n      <el-table-column label=\"任务ID\" align=\"center\" prop=\"taskId\" />\r\n      <el-table-column label=\"批次ID\" align=\"center\" prop=\"batchId\" />\r\n      <el-table-column label=\"任务负责人\" align=\"center\" prop=\"taskHead\">\r\n        <template slot-scope=\"scope\">\r\n          <data-tag\r\n            :options=\"userList\"\r\n            :value=\"scope.row.taskHead\"\r\n            labelName=\"userName\"\r\n            valueName=\"userId\"\r\n            type=\"notag\"\r\n          />\r\n        </template>\r\n      </el-table-column>\r\n      <el-table-column label=\"任务名称\" align=\"center\" prop=\"taskName\" />\r\n      <el-table-column label=\"计划开始日期\" align=\"center\" prop=\"planStart\" width=\"180\">\r\n        <template slot-scope=\"scope\">\r\n          <span>{{ parseTime(scope.row.planStart, '{y}-{m}-{d}') }}</span>\r\n        </template>\r\n      </el-table-column>\r\n      <el-table-column label=\"计划结束日期\" align=\"center\" prop=\"planFinish\" width=\"180\">\r\n        <template slot-scope=\"scope\">\r\n          <span>{{ parseTime(scope.row.planFinish, '{y}-{m}-{d}') }}</span>\r\n        </template>\r\n      </el-table-column>\r\n      <el-table-column label=\"实际开始日期\" align=\"center\" prop=\"actualStart\" width=\"180\">\r\n        <template slot-scope=\"scope\">\r\n          <span>{{ parseTime(scope.row.actualStart, '{y}-{m}-{d}') }}</span>\r\n        </template>\r\n      </el-table-column>\r\n      <el-table-column label=\"实际结束日期\" align=\"center\" prop=\"actualFinish\" width=\"180\">\r\n        <template slot-scope=\"scope\">\r\n          <span>{{ parseTime(scope.row.actualFinish, '{y}-{m}-{d}') }}</span>\r\n        </template>\r\n      </el-table-column>\r\n      <el-table-column label=\"任务详情\" align=\"center\" prop=\"taskDetail\" />\r\n      <el-table-column label=\"图片资料\" align=\"center\" prop=\"taskImages\" width=\"100\">\r\n        <template slot-scope=\"scope\">\r\n          <image-preview :src=\"scope.row.taskImages\" :width=\"50\" :height=\"50\"/>\r\n        </template>\r\n      </el-table-column>\r\n      <el-table-column label=\"视频资料\" align=\"center\" prop=\"taskVideos\" />\r\n      <el-table-column label=\"备注\" align=\"center\" prop=\"remark\" />\r\n      <el-table-column label=\"状态\" align=\"center\" prop=\"status\">\r\n        <template slot-scope=\"scope\">\r\n          <dict-tag :options=\"dict.type.agriculture_batch_task_status\" :value=\"scope.row.status\"/>\r\n        </template>\r\n      </el-table-column>\r\n      <el-table-column label=\"排序\" align=\"center\" prop=\"orderNum\" />\r\n      <el-table-column label=\"操作\" align=\"center\" class-name=\"small-padding fixed-width\">\r\n        <template slot-scope=\"scope\">\r\n          <el-button\r\n            size=\"mini\"\r\n            type=\"text\"\r\n            icon=\"el-icon-edit\"\r\n            @click=\"handleUpdate(scope.row)\"\r\n            v-hasPermi=\"['system:task:edit']\"\r\n          >修改</el-button>\r\n          <el-button\r\n            size=\"mini\"\r\n            type=\"text\"\r\n            icon=\"el-icon-delete\"\r\n            @click=\"handleDelete(scope.row)\"\r\n            v-hasPermi=\"['system:task:remove']\"\r\n          >删除</el-button>\r\n        </template>\r\n      </el-table-column>\r\n    </el-table>\r\n    \r\n    <pagination\r\n      v-show=\"total>0\"\r\n      :total=\"total\"\r\n      :page.sync=\"queryParams.pageNum\"\r\n      :limit.sync=\"queryParams.pageSize\"\r\n      @pagination=\"getList\"\r\n    />\r\n\r\n    <!-- 添加或修改批次任务对话框 -->\r\n    <el-dialog :title=\"title\" :visible.sync=\"open\" width=\"500px\" append-to-body>\r\n      <el-form ref=\"form\" :model=\"form\" :rules=\"rules\" label-width=\"100px\">\r\n        <el-row>\r\n          <el-col :span=\"24\">\r\n            <el-form-item label=\"任务名称\" prop=\"taskName\">\r\n              <el-input v-model=\"form.taskName\" placeholder=\"请输入任务名称\" />\r\n            </el-form-item>\r\n          </el-col>\r\n          <el-col :span=\"24\">\r\n            <el-form-item label=\"任务负责人\" prop=\"taskHead\">\r\n              <el-select v-model.number=\"form.taskHead\" placeholder=\"请选择任务负责人\">\r\n                <el-option\r\n                  v-for=\"user in userList\"\r\n                  :key=\"user.userId\"\r\n                  :label=\"user.nickName\"\r\n                  :value=\"Number(user.userId)\"\r\n                ></el-option>\r\n              </el-select>\r\n            </el-form-item>\r\n          </el-col>\r\n          <el-col :span=\"24\">\r\n            <el-form-item label=\"任务状态\" prop=\"status\">\r\n              <el-select v-model=\"form.status\" placeholder=\"请选择任务状态\">\r\n                <el-option\r\n                  v-for=\"dict in dict.type.agriculture_batch_task_status\"\r\n                  :key=\"dict.value\"\r\n                  :label=\"dict.label\"\r\n                  :value=\"dict.value\"\r\n                ></el-option>\r\n              </el-select>\r\n            </el-form-item>\r\n          </el-col>\r\n          <el-col :span=\"24\">\r\n            <el-form-item label=\"计划开始日期\" prop=\"planStart\">\r\n              <el-date-picker clearable\r\n                v-model=\"form.planStart\"\r\n                type=\"date\"\r\n                value-format=\"yyyy-MM-dd\"\r\n                placeholder=\"请选择计划开始日期\">\r\n              </el-date-picker>\r\n            </el-form-item>\r\n          </el-col>\r\n          <el-col :span=\"24\">\r\n            <el-form-item label=\"计划结束日期\" prop=\"planFinish\">\r\n              <el-date-picker clearable\r\n                v-model=\"form.planFinish\"\r\n                type=\"date\"\r\n                value-format=\"yyyy-MM-dd\"\r\n                placeholder=\"请选择计划结束日期\">\r\n              </el-date-picker>\r\n            </el-form-item>\r\n          </el-col>\r\n          <el-col :span=\"24\">\r\n            <el-form-item label=\"实际开始日期\" prop=\"actualStart\">\r\n              <el-date-picker clearable\r\n                v-model=\"form.actualStart\"\r\n                type=\"date\"\r\n                value-format=\"yyyy-MM-dd\"\r\n                placeholder=\"请选择实际开始日期\">\r\n              </el-date-picker>\r\n            </el-form-item>\r\n          </el-col>\r\n          <el-col :span=\"24\">\r\n            <el-form-item label=\"实际结束日期\" prop=\"actualFinish\">\r\n              <el-date-picker clearable\r\n                v-model=\"form.actualFinish\"\r\n                type=\"date\"\r\n                value-format=\"yyyy-MM-dd\"\r\n                placeholder=\"请选择实际结束日期\">\r\n              </el-date-picker>\r\n            </el-form-item>\r\n          </el-col>\r\n          <el-col :span=\"24\">\r\n            <el-form-item label=\"任务详情\" prop=\"taskDetail\">\r\n              <el-input v-model=\"form.taskDetail\" type=\"textarea\" placeholder=\"请输入内容\" />\r\n            </el-form-item>\r\n          </el-col>\r\n          <el-col :span=\"24\">\r\n            <el-form-item label=\"图片资料\" prop=\"taskImages\">\r\n              <image-upload v-model=\"form.taskImages\" :limit=\"5\" :action=\"uploadAction\"/>\r\n            </el-form-item>\r\n          </el-col>\r\n          <el-col :span=\"24\">\r\n            <el-form-item label=\"视频资料\" prop=\"taskVideos\">\r\n              <el-input v-model=\"form.taskVideos\" type=\"textarea\" placeholder=\"请输入内容\" />\r\n            </el-form-item>\r\n          </el-col>\r\n          <el-col :span=\"24\">\r\n            <el-form-item label=\"备注\" prop=\"remark\">\r\n              <el-input v-model=\"form.remark\" type=\"textarea\" placeholder=\"请输入内容\" />\r\n            </el-form-item>\r\n          </el-col>\r\n        </el-row>\r\n      </el-form>\r\n      <div slot=\"footer\" class=\"dialog-footer\">\r\n        <el-button type=\"primary\" @click=\"submitForm\">确 定</el-button>\r\n        <el-button @click=\"cancel\">取 消</el-button>\r\n      </div>\r\n    </el-dialog>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { listTask, getTask, delTask, addTask, updateTask } from \"@/api/system/task\"\r\nimport { listUser } from \"@/api/system/user\"\r\n\r\nexport default {\r\n  name: \"Task\",\r\n  dicts: ['agriculture_batch_task_status'],\r\n  props: {\r\n    batchId: {\r\n      type: String,\r\n      default: null\r\n    },\r\n    batchHead: {\r\n      type: [Number, String],\r\n      default: null\r\n    },\r\n    tableBorder: {\r\n      type: Boolean,\r\n      default: false\r\n    }\r\n  },\r\n  data() {\r\n    return {\r\n      // 上传接口地址\r\n      uploadAction: \"/system/germplasm/upload\",\r\n      // 遮罩层\r\n      loading: true,\r\n      // 选中数组\r\n      ids: [],\r\n      // 非单个禁用\r\n      single: true,\r\n      // 非多个禁用\r\n      multiple: true,\r\n      // 显示搜索条件\r\n      showSearch: true,\r\n      // 总条数\r\n      total: 0,\r\n      // 批次任务表格数据\r\n      taskList: [],\r\n      // 用户列表\r\n      userList: [],\r\n      // 弹出层标题\r\n      title: \"\",\r\n      // 是否显示弹出层\r\n      open: false,\r\n      // 查询参数\r\n      queryParams: {\r\n        pageNum: 1,\r\n        pageSize: 10,\r\n        batchId: null,\r\n        taskHead: null,\r\n        taskName: null,\r\n        planStart: null,\r\n        planFinish: null,\r\n        actualStart: null,\r\n        actualFinish: null,\r\n        taskDetail: null,\r\n        taskImages: null,\r\n        taskVideos: null,\r\n        status: null,\r\n        orderNum: null,\r\n      },\r\n      // 表单参数\r\n      form: {},\r\n      // 表单校验\r\n      rules: {\r\n        taskName: [\r\n          { required: true, message: \"任务名称不能为空\", trigger: \"blur\" }\r\n        ],\r\n        taskDetail: [\r\n          { required: true, message: \"任务详情不能为空\", trigger: \"blur\" }\r\n        ],\r\n        remark: [\r\n          { required: true, message: \"备注不能为空\", trigger: \"blur\" }\r\n        ],\r\n        status: [\r\n          { required: true, message: \"状态不能为空\", trigger: \"change\" }\r\n        ],\r\n        orderNum: [\r\n          { required: true, message: \"排序不能为空\", trigger: \"blur\" }\r\n        ],\r\n        createBy: [\r\n          { required: true, message: \"创建者ID不能为空\", trigger: \"blur\" }\r\n        ],\r\n        delFlag: [\r\n          { required: true, message: \"删除标志不能为空\", trigger: \"blur\" }\r\n        ]\r\n      }\r\n    }\r\n  },\r\n  created() {\r\n    if (this.batchId) {\r\n      this.queryParams.batchId = this.batchId\r\n    }\r\n    this.getUserList()\r\n    this.getList()\r\n  },\r\n  methods: {\r\n    /** 获取用户列表 */\r\n    getUserList() {\r\n      return listUser().then(response => {\r\n        this.userList = response.rows\r\n      })\r\n    },\r\n    /** 查询批次任务列表 */\r\n    getList() {\r\n      this.loading = true\r\n      listTask(this.queryParams).then(response => {\r\n        this.taskList = response.rows\r\n        this.total = response.total\r\n        this.loading = false\r\n      })\r\n    },\r\n    // 取消按钮\r\n    cancel() {\r\n      this.open = false\r\n      this.reset()\r\n    },\r\n    // 表单重置\r\n    reset() {\r\n      this.form = {\r\n        taskId: null,\r\n        batchId: null,\r\n        taskHead: null,\r\n        taskName: null,\r\n        planStart: null,\r\n        planFinish: null,\r\n        actualStart: null,\r\n        actualFinish: null,\r\n        taskDetail: null,\r\n        taskImages: null,\r\n        taskVideos: null,\r\n        remark: null,\r\n        status: null,\r\n        orderNum: null,\r\n        createBy: null,\r\n        createTime: null,\r\n        updateBy: null,\r\n        updateTime: null,\r\n        delFlag: null\r\n      }\r\n      this.resetForm(\"form\")\r\n    },\r\n    /** 搜索按钮操作 */\r\n    handleQuery() {\r\n      this.queryParams.pageNum = 1\r\n      this.getList()\r\n    },\r\n    /** 重置按钮操作 */\r\n    resetQuery() {\r\n      this.resetForm(\"queryForm\")\r\n      this.handleQuery()\r\n    },\r\n    // 多选框选中数据\r\n    handleSelectionChange(selection) {\r\n      this.ids = selection.map(item => item.taskId)\r\n      this.single = selection.length !== 1\r\n      this.multiple = !selection.length\r\n    },\r\n    /** 新增按钮操作 */\r\n    handleAdd() {\r\n      this.reset()\r\n      if (this.batchId) {\r\n        this.form.batchId = this.batchId\r\n      }\r\n      if (this.batchHead) {\r\n        this.form.taskHead = Number(this.batchHead)\r\n      }\r\n      this.open = true\r\n      this.title = \"添加批次任务\"\r\n    },\r\n    /** 修改按钮操作 */\r\n    handleUpdate(row) {\r\n      this.reset()\r\n      const taskId = row.taskId || this.ids\r\n      Promise.all([\r\n        this.getUserList(),\r\n        getTask(taskId)\r\n      ]).then(([_, taskRes]) => {\r\n        this.form = taskRes.data\r\n        // 类型转换：确保负责人ID为数字类型\r\n        this.form.taskHead = this.toNumber(this.form.taskHead)\r\n        this.open = true\r\n        this.title = \"修改批次任务\"\r\n      }).catch(err => {\r\n        this.$modal.msgError(\"加载数据失败：\" + (err.message || \"未知错误\"))\r\n      })\r\n    },\r\n    /** 安全的类型转换：String → Number */\r\n    toNumber(value) {\r\n      if (value == null || value === '') return null\r\n      const num = Number(value)\r\n      return isNaN(num) ? null : num\r\n    },\r\n    /** 提交按钮 */\r\n    submitForm() {\r\n      this.$refs[\"form\"].validate(valid => {\r\n        if (valid) {\r\n          if (this.form.taskId != null) {\r\n            updateTask(this.form).then(response => {\r\n              this.$modal.msgSuccess(\"修改成功\")\r\n              this.ope