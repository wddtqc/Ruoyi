.sync=\"visible\" direction=\"rtl\" size=\"68%\" append-to-body :before-close=\"handleClose\" custom-class=\"detail-drawer\">\r\n    <div v-loading=\"loading\" class=\"drawer-content\">\r\n      <!-- 基本信息 -->\r\n      <h4 class=\"section-header\">基本信息</h4>\r\n      <el-row :gutter=\"20\" class=\"mb8\">\r\n        <el-col :span=\"12\">\r\n          <div class=\"info-item\">\r\n            <label class=\"info-label\">用户名称：</label>\r\n            <span class=\"info-value plaintext\">{{ info.nickName }}</span>\r\n          </div>\r\n        </el-col>\r\n        <el-col :span=\"12\">\r\n          <div class=\"info-item\">\r\n            <label class=\"info-label\">归属部门：</label>\r\n            <span class=\"info-value plaintext\">{{ (info.dept && info.dept.deptName) }}</span>\r\n          </div>\r\n        </el-col>\r\n      </el-row>\r\n      <el-row :gutter=\"20\" class=\"mb8\">\r\n        <el-col :span=\"12\">\r\n          <div class=\"info-item\">\r\n            <label class=\"info-label\">手机号码：</label>\r\n            <span class=\"info-value plaintext\">{{ info.phonenumber }}</span>\r\n          </div>\r\n        </el-col>\r\n        <el-col :span=\"12\">\r\n          <div class=\"info-item\">\r\n            <label class=\"info-label\">邮箱：</label>\r\n            <span class=\"info-value plaintext\">{{ info.email }}</span>\r\n          </div>\r\n        </el-col>\r\n      </el-row>\r\n      <el-row :gutter=\"20\" class=\"mb8\">\r\n        <el-col :span=\"12\">\r\n          <div class=\"info-item\">\r\n            <label class=\"info-label\">登录账号：</label>\r\n            <span class=\"info-value plaintext\">{{ info.userName }}</span>\r\n          </div>\r\n        </el-col>\r\n        <el-col :span=\"12\">\r\n          <div class=\"info-item\">\r\n            <label class=\"info-label\">用户状态：</label>\r\n            <span class=\"info-value plaintext\">\r\n              <el-tag size=\"small\" :type=\"info.status === '0' ? 'success' : 'danger'\">{{ info.status === '0' ? '正常' : '停用' }}</el-tag>\r\n            </span>\r\n          </div>\r\n        </el-col>\r\n      </el-row>\r\n      <el-row :gutter=\"20\" class=\"mb8\">\r\n        <el-col :span=\"12\">\r\n          <div class=\"info-item\">\r\n            <label class=\"info-label\">岗位：</label>\r\n            <span class=\"info-value plaintext\">{{ postNames || '无岗位' }}</span>\r\n          </div>\r\n        </el-col>\r\n        <el-col :span=\"12\">\r\n          <div class=\"info-item\">\r\n            <label class=\"info-label\">用户性别：</label>\r\n            <span class=\"info-value plaintext\">{{ sexLabel }}</span>\r\n          </div>\r\n        </el-col>\r\n      </el-row>\r\n      <el-row :gutter=\"20\" class=\"mb8\">\r\n        <el-col :span=\"24\">\r\n          <div class=\"info-item full-width\">\r\n            <label class=\"info-label\">角色：</label>\r\n            <span class=\"info-value plaintext\">{{ roleNames || '无角色' }}</span>\r\n          </div>\r\n        </el-col>\r\n      </el-row>\r\n      <!-- 其他信息 -->\r\n      <h4 class=\"section-header\">其他信息</h4>\r\n      <el-row :gutter=\"20\" class=\"mb8\">\r\n        <el-col :span=\"12\">\r\n          <div class=\"info-item\">\r\n            <label class=\"info-label\">创建者：</label>\r\n            <span class=\"info-value plaintext\">{{ info.createBy }}</span>\r\n          </div>\r\n        </el-col>\r\n        <el-col :span=\"12\">\r\n          <div class=\"info-item\">\r\n            <label class=\"info-label\">创建时间：</label>\r\n            <span class=\"info-value plaintext\">{{ info.createTime }}</span>\r\n          </div>\r\n        </el-col>\r\n      </el-row>\r\n      <el-row :gutter=\"20\" class=\"mb8\">\r\n        <el-col :span=\"12\">\r\n          <div class=\"info-item\">\r\n            <label class=\"info-label\">更新者：</label>\r\n            <span class=\"info-value plaintext\">{{ info.updateBy }}</span>\r\n          </div>\r\n        </el-col>\r\n        <el-col :span=\"12\">\r\n          <div class=\"info-item\">\r\n            <label class=\"info-label\">更新时间：</label>\r\n            <span class=\"info-value plaintext\">{{ info.updateTime }}</span>\r\n          </div>\r\n        </el-col>\r\n      </el-row>\r\n      <el-row :gutter=\"20\" class=\"mb8\">\r\n        <el-col :span=\"12\">\r\n          <div class=\"info-item\">\r\n            <label class=\"info-label\">最后登录IP：</label>\r\n            <span class=\"info-value plaintext\">{{ info.loginIp }}</span>\r\n          </div>\r\n        </el-col>\r\n        <el-col :span=\"12\">\r\n          <div class=\"info-item\">\r\n            <label class=\"info-label\">最后登录时间：</label>\r\n            <span class=\"info-value plaintext\">{{ info.loginDate }}</span>\r\n          </div>\r\n        </el-col>\r\n      </el-row>\r\n      <el-row :gutter=\"20\" class=\"mb8\">\r\n        <el-col :span=\"24\">\r\n          <div class=\"info-item full-width\">\r\n            <label class=\"info-label\">备注：</label>\r\n            <span class=\"info-value plaintext\">{{ info.remark }}</span>\r\n          </div>\r\n        </el-col>\r\n      </el-row>\r\n    </div>\r\n  </el-drawer>\r\n</template>\r\n\r\n<script>\r\nimport { getUser } from '@/api/system/user'\r\n\r\nexport default {\r\n  name: 'UserViewDrawer',\r\n  dicts: ['sys_user_sex'],\r\n  data() {\r\n    return {\r\n      visible: false,\r\n      loading: false,\r\n      info: {},\r\n      postOptions: [],\r\n      roleOptions: []\r\n    }\r\n  },\r\n  computed: {\r\n    sexLabel() {\r\n      return this.selectDictLabel(this.dict.type.sys_user_sex, this.info.sex) || '-'\r\n    },\r\n    postNames() {\r\n      if (!this.postOptions.length) return ''\r\n      const ids = this.info.postIds || []\r\n      return this.postOptions.filter(p => ids.includes(p.postId)).map(p => p.postName).join('、') || ''\r\n    },\r\n    roleNames() {\r\n      if (!this.roleOptions.length) return ''\r\n      const ids = this.info.roleIds || []\r\n      return this.roleOptions.filter(r => ids.includes(r.roleId)).map(r => r.roleName).join('、') || ''\r\n    }\r\n  },\r\n  methods: {\r\n    open(userId) {\r\n      this.visible = true\r\n      this.loading = true\r\n      getUser(userId).then(res => {\r\n        this.info = res.data || {}\r\n        this.postOptions = res.posts || []\r\n        this.roleOptions = res.roles || []\r\n        this.info.postIds = res.postIds || []\r\n        this.info.roleIds = res.roleIds || []\r\n      }).finally(() => {\r\n        this.loading = false\r\n      })\r\n    },\r\n    handleClose() {\r\n      this.visible = false\r\n    }\r\n  }\r\n}\r\n</script>\r\n"],"mappings":";;;;;;;;;;;;;;;AAgIA,IAAAA,KAAA,GAAAC,OAAA;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;iCAEA;EACAC,IAAA;EACAC,KAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,OAAA;MACAC,OAAA;MACAC,IAAA;MACAC,WAAA;MACAC,WAAA;IACA;EACA;EACAC,QAAA;IACAC,QAAA,WAAAA,SAAA;MACA,YAAAC,eAAA,MAAAC,IAAA,CAAAC,IAAA,CAAAC,YAAA,OAAAR,IAAA,CAAAS,GAAA;IACA;IACAC,SAAA,WAAAA,UAAA;MACA,UAAAT,WAAA,CAAAU,MAAA;MACA,IAAAC,GAAA,QAAAZ,IAAA,CAAAa,OAAA;MACA,YAAAZ,WAAA,CAAAa,MAAA,WAAAC,CAAA;QAAA,OAAAH,GAAA,CAAAI,QAAA,CAAAD,CAAA,CAAAE,MAAA;MAAA,GAAAC,GAAA,WAAAH,CAAA;QAAA,OAAAA,CAAA,CAAAI,QAAA;MAAA,GAAAC,IAAA;IACA;IACAC,SAAA,WAAAA,UAAA;MACA,UAAAnB,WAAA,CAAAS,MAAA;MACA,IAAAC,GAAA,QAAAZ,IAAA,CAAAsB,OAAA;MACA,YAAApB,WAAA,CAAAY,MAAA,WAAAS,CAAA;QAAA,OAAAX,GAAA,CAAAI,QAAA,CAAAO,CAAA,CAAAC,MAAA;MAAA,GAAAN,GAAA,WAAAK,CAAA;QAAA,OAAAA,CAAA,CAAAE,QAAA;MAAA,GAAAL,IAAA;IACA;EACA;EACAM,OAAA;IACAC,IAAA,WAAAA,KAAAC,MAAA;MAAA,IAAAC,KAAA;MACA,KAAA/B,OAAA;MACA,KAAAC,OAAA;MACA,IAAA+B,aAAA,EAAAF,MAAA,EAAAG,IAAA,WAAAC,GAAA;QACAH,KAAA,CAAA7B,IAAA,GAAAgC,GAAA,CAAAnC,IAAA;QACAgC,KAAA,CAAA5B,WAAA,GAAA+B,GAAA,CAAAC,KAAA;QACAJ,KAAA,CAAA3B,WAAA,GAAA8B,GAAA,CAAAE,KAAA;QACAL,KAAA,CAAA7B,IAAA,CAAAa,OAAA,GAAAmB,GAAA,CAAAnB,OAAA;QACAgB,KAAA,CAAA7B,IAAA,CAAAsB,OAAA,GAAAU,GAAA,CAAAV,OAAA;MACA,GAAAa,OAAA;QACAN,KAAA,CAAA9B,OAAA;MACA;IACA;IACAqC,WAAA,WAAAA,YAAA;MACA,KAAAtC,OAAA;IACA;EACA;