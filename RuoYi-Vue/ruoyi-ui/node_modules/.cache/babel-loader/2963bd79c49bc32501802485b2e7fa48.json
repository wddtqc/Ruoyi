{"remainingRequest":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\node_modules\\babel-loader\\lib\\index.js!D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\node_modules\\cache-loader\\dist\\cjs.js??ref--0-0!D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\src\\layout\\components\\HeaderNotice\\index.vue?vue&type=script&lang=js","dependencies":[{"path":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\src\\layout\\components\\HeaderNotice\\index.vue","mtime":1780922369572},{"path":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\babel.config.js","mtime":1780922369473},{"path":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1781061437342},{"path":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\node_modules\\babel-loader\\lib\\index.js","mtime":1781061438494},{"path":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1781061437342},{"path":"D:\\Program Files (x86)\\githubdesk_events\\Ruoyi\\RuoYi-Vue\\ruoyi-ui\\node_modules\\vue-loader\\lib\\index.js","mtime":1781061438994}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["_DetailView","_interopRequireDefault","require","_notice","name","components","NoticeDetailView","data","noticeList","unreadCount","noticeLoading","noticeVisible","noticeLeaveTimer","mounted","loadNoticeTop","methods","onNoticeEnter","_this","clearTimeout","$nextTick","popper","$refs","noticePopover","_noticeBound","addEventListener","setTimeout","onNoticeLeave","_this2","_this3","listNoticeTop","then","res","undefined","filter","n","isRead","length","finally","previewNotice","item","markNoticeRead","noticeId","catch","idx","indexOf","$set","_objectSpread2","default","Math","max","noticeViewRef","open","markAllRead","ids","map","join","markNoticeReadAll"],"sources":["src/layout/components/HeaderNotice/index.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <el-popover ref=\"noticePopover\" placement=\"bottom-end\" width=\"320\" trigger=\"manual\" :value=\"noticeVisible\" popper-class=\"notice-popover\">\r\n      <div class=\"notice-header\">\r\n        <span class=\"notice-title\">通知公告</span>\r\n        <span class=\"notice-mark-all\" @click=\"markAllRead\">全部已读</span>\r\n      </div>\r\n      <div v-if=\"noticeLoading\" class=\"notice-loading\"><i class=\"el-icon-loading\"></i> 加载中...</div>\r\n      <div v-else-if=\"noticeList.length === 0\" class=\"notice-empty\"><i class=\"el-icon-inbox\"></i><br>暂无公告</div>\r\n      <div v-else>\r\n        <div v-for=\"item in noticeList\" :key=\"item.noticeId\" class=\"notice-item\" :class=\"{ 'is-read': item.isRead }\" @click=\"previewNotice(item)\">\r\n          <el-tag size=\"mini\" :type=\"item.noticeType === '1' ? 'warning' : 'success'\" class=\"notice-tag\">\r\n            {{ item.noticeType === '1' ? '通知' : '公告' }}\r\n          </el-tag>\r\n          <span class=\"notice-item-title\">{{ item.noticeTitle }}</span>\r\n          <span class=\"notice-item-date\">{{ item.createTime }}</span>\r\n        </div>\r\n      </div>\r\n    </el-popover>\r\n\r\n    <div v-popover:noticePopover class=\"right-menu-item hover-effect notice-trigger\" @mouseenter=\"onNoticeEnter\" @mouseleave=\"onNoticeLeave\">\r\n      <svg-icon icon-class=\"bell\" />\r\n      <span v-if=\"unreadCount > 0\" class=\"notice-badge\">{{ unreadCount }}</span>\r\n    </div>\r\n\r\n    <notice-detail-view ref=\"noticeViewRef\" />\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport NoticeDetailView from './DetailView'\r\nimport { listNoticeTop, markNoticeRead, markNoticeReadAll } from '@/api/system/notice'\r\n\r\nexport default {\r\n  name: 'HeaderNotice',\r\n  components: { NoticeDetailView },\r\n  data() {\r\n    return {\r\n      noticeList: [], // 通知列表\r\n      unreadCount: 0, // 未读数量\r\n      noticeLoading: false, // 加载状态\r\n      noticeVisible: false, // 弹出层显示状态\r\n      noticeLeaveTimer: null // 鼠标离开计时器\r\n    }\r\n  },\r\n  mounted() {\r\n    this.loadNoticeTop()\r\n  },\r\n  methods: {\r\n    // 鼠标移入铃铛区域\r\n    onNoticeEnter() {\r\n      clearTimeout(this.noticeLeaveTimer)\r\n      this.noticeVisible = true\r\n      this.$nextTick(() => {\r\n        const popper = this.$refs.noticePopover.$refs.popper\r\n        if (popper && !popper._noticeBound) {\r\n          popper._noticeBound = true\r\n          popper.addEventListener('mouseenter', () => clearTimeout(this.noticeLeaveTimer))\r\n          popper.addEventListener('mouseleave', () => {\r\n            this.noticeLeaveTimer = setTimeout(() => { this.noticeVisible = false }, 100)\r\n          })\r\n        }\r\n      })\r\n    },\r\n    // 鼠标离开铃铛区域\r\n    onNoticeLeave() {\r\n      this.noticeLeaveTimer = setTimeout(() => { this.noticeVisible = false }, 150)\r\n    },\r\n    // 加载顶部公告列表\r\n    loadNoticeTop() {\r\n      this.noticeLoading = true\r\n      listNoticeTop().then(res => {\r\n        this.noticeList = res.data || []\r\n        this.unreadCount = res.unreadCount !== undefined ? res.unreadCount : this.noticeList.filter(n => !n.isRead).length\r\n      }).finally(() => {\r\n        this.noticeLoading = false\r\n      })\r\n    },\r\n    // 预览公告详情\r\n    previewNotice(item) {\r\n      if (!item.isRead) {\r\n        markNoticeRead(item.noticeId).catch(() => {})\r\n        item.isRead = true\r\n        const idx = this.noticeList.indexOf(item)\r\n        if (idx !== -1) this.$set(this.noticeList, idx, { ...item, isRead: true })\r\n        this.unreadCount = Math.max(0, this.unreadCount - 1)\r\n      }\r\n      this.$refs.noticeViewRef.open(item.noticeId)\r\n    },\r\n    // 全部已读\r\n    markAllRead() {\r\n      const ids = this.noticeList.map(n => n.noticeId).join(',')\r\n      if (!ids) return\r\n      markNoticeReadAll(ids).catch(() => {})\r\n      this.noticeList = this.noticeList.map(n => ({ ...n, isRead: true }))\r\n      this.unreadCount = 0\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style lang=\"scss\" scoped>\r\n.notice-trigger {\r\n  position: relative;\r\n  transform: translateX(-6px);\r\n  .svg-icon { width: 1.2em; height: 1.2em; vertical-align: -0.2em; }\r\n  .notice-badge {\r\n    position: absolute;\r\n    top: 7px;\r\n    right: -3px;\r\n    background: #f56c6c;\r\n    color: #fff;\r\n    border-radius: 10px;\r\n    font-size: 10px;\r\n    height: 16px;\r\n    line-height: 16px;\r\n    padding: 0 4px;\r\n    min-width: 16px;\r\n    text-align: center;\r\n    white-space: nowrap;\r\n    pointer-events: none;\r\n  }\r\n}\r\n.notice-popover {\r\n  padding: 0 !important;\r\n}\r\n.notice-popover .notice-header {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  padding: 10px 14px;\r\n  background: #f7f9fb;\r\n  border-bottom: 1px solid #eee;\r\n  font-size: 13px;\r\n  font-weight: 600;\r\n  color: #333;\r\n}\r\n.notice-popover .notice-mark-all {\r\n  font-size: 12px;\r\n  color: #409EFF;\r\n  font-weight: normal;\r\n  cursor: pointer;\r\n}\r\n.notice-popover .notice-mark-all:hover { color: #2b7cc1; }\r\n.notice-popover .notice-loading,\r\n.notice-popover .notice-empty {\r\n  padding: 24px;\r\n  text-align: center;\r\n  color: #bbb;\r\n  font-size: 12px;\r\n  line-height: 1.8;\r\n}\r\n.notice-popover .notice-item {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  padding: 10px 14px;\r\n  border-bottom: 1px solid #f5f5f5;\r\n  cursor: pointer;\r\n  transition: background 0.15s;\r\n}\r\n.notice-popover .notice-item:last-child { border-bottom: none; }\r\n.notice-popover .notice-item:hover { background: #f7f9fb; }\r\n.notice-popover .notice-item.is-read .notice-tag,\r\n.notice-popover .notice-item.is-read .notice-item-title,\r\n.notice-popover .notice-item.is-read .notice-item-date { opacity: 0.45; filter: grayscale(1); color: #999; }\r\n.notice-popover .notice-tag { flex-shrink: 0; }\r\n.notice-popover .notice-item-title {\r\n  flex: 1;\r\n  font-size: 12px;\r\n  color: #333;\r\n  overflow: hidden;\r\n  white-space: nowrap;\r\n  text-overflow: ellipsis;\r\n}\r\n.notice-popover .notice-item-date {\r\n  flex-shrink: 0;\r\n  font-size: 11px;\r\n  color: #bbb;\r\n}\r\n</style>\r\n"],"mappings":";;;;;;;;;;;;;;;AA8BA,IAAAA,WAAA,GAAAC,sBAAA,CAAAC,OAAA;AACA,IAAAC,OAAA,GAAAD,OAAA;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;iCAEA;EACAE,IAAA;EACAC,UAAA;IAAAC,gBAAA,EAAAA;EAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,UAAA;MAAA;MACAC,WAAA;MAAA;MACAC,aAAA;MAAA;MACAC,aAAA;MAAA;MACAC,gBAAA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA;IACA,KAAAC,aAAA;EACA;EACAC,OAAA;IACA;IACAC,aAAA,WAAAA,cAAA;MAAA,IAAAC,KAAA;MACAC,YAAA,MAAAN,gBAAA;MACA,KAAAD,aAAA;MACA,KAAAQ,SAAA;QACA,IAAAC,MAAA,GAAAH,KAAA,CAAAI,KAAA,CAAAC,aAAA,CAAAD,KAAA,CAAAD,MAAA;QACA,IAAAA,MAAA,KAAAA,MAAA,CAAAG,YAAA;UACAH,MAAA,CAAAG,YAAA;UACAH,MAAA,CAAAI,gBAAA;YAAA,OAAAN,YAAA,CAAAD,KAAA,CAAAL,gBAAA;UAAA;UACAQ,MAAA,CAAAI,gBAAA;YACAP,KAAA,CAAAL,gBAAA,GAAAa,UAAA;cAAAR,KAAA,CAAAN,aAAA;YAAA;UACA;QACA;MACA;IACA;IACA;IACAe,aAAA,WAAAA,cAAA;MAAA,IAAAC,MAAA;MACA,KAAAf,gBAAA,GAAAa,UAAA;QAAAE,MAAA,CAAAhB,aAAA;MAAA;IACA;IACA;IACAG,aAAA,WAAAA,cAAA;MAAA,IAAAc,MAAA;MACA,KAAAlB,aAAA;MACA,IAAAmB,qBAAA,IAAAC,IAAA,WAAAC,GAAA;QACAH,MAAA,CAAApB,UAAA,GAAAuB,GAAA,CAAAxB,IAAA;QACAqB,MAAA,CAAAnB,WAAA,GAAAsB,GAAA,CAAAtB,WAAA,KAAAuB,SAAA,GAAAD,GAAA,CAAAtB,WAAA,GAAAmB,MAAA,CAAApB,UAAA,CAAAyB,MAAA,WAAAC,CAAA;UAAA,QAAAA,CAAA,CAAAC,MAAA;QAAA,GAAAC,MAAA;MACA,GAAAC,OAAA;QACAT,MAAA,CAAAlB,aAAA;MACA;IACA;IACA;IACA4B,aAAA,WAAAA,cAAAC,IAAA;MACA,KAAAA,IAAA,CAAAJ,MAAA;QACA,IAAAK,sBAAA,EAAAD,IAAA,CAAAE,QAAA,EAAAC,KAAA;QACAH,IAAA,CAAAJ,MAAA;QACA,IAAAQ,GAAA,QAAAnC,UAAA,CAAAoC,OAAA,CAAAL,IAAA;QACA,IAAAI,GAAA,cAAAE,IAAA,MAAArC,UAAA,EAAAmC,GAAA,MAAAG,cAAA,CAAAC,OAAA,MAAAD,cAAA,CAAAC,OAAA,MAAAR,IAAA;UAAAJ,MAAA;QAAA;QACA,KAAA1B,WAAA,GAAAuC,IAAA,CAAAC,GA