<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.iot.mapper.IotSensorDataMapper">

    <resultMap type="com.ruoyi.iot.domain.IotSensorData" id="IotSensorDataResult">
        <id     property="id"               column="id"                />
        <result property="serialNumber"     column="serial_number"     />
        <result property="deviceType"       column="device_type"       />
        <result property="humidity"         column="humidity"          />
        <result property="temperature"      column="temperature"       />
        <result property="soilPh"           column="soil_ph"           />
        <result property="nitrogen"         column="nitrogen"          />
        <result property="phosphorus"       column="phosphorus"        />
        <result property="potassium"        column="potassium"         />
        <result property="signalStrength"   column="signal_strength"   />
        <result property="deviceTimestamp"  column="device_timestamp"  />
        <result property="createTime"       column="create_time"       />
    </resultMap>

    <insert id="insertIotSensorData" parameterType="com.ruoyi.iot.domain.IotSensorData">
        INSERT INTO iot_sensor_data
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="serialNumber != null and serialNumber != ''">serial_number,</if>
            <if test="deviceType != null and deviceType != ''">device_type,</if>
            <if test="humidity != null">humidity,</if>
            <if test="temperature != null">temperature,</if>
            <if test="soilPh != null">soil_ph,</if>
            <if test="nitrogen != null">nitrogen,</if>
            <if test="phosphorus != null">phosphorus,</if>
            <if test="potassium != null">potassium,</if>
            <if test="signalStrength != null">signal_strength,</if>
            <if test="deviceTimestamp != null">device_timestamp,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="serialNumber != null and serialNumber != ''">#{serialNumber},</if>
            <if test="deviceType != null and deviceType != ''">#{deviceType},</if>
            <if test="humidity != null">#{humidity},</if>
            <if test="temperature != null">#{temperature},</if>
            <if test="soilPh != null">#{soilPh},</if>
            <if test="nitrogen != null">#{nitrogen},</if>
            <if test="phosphorus != null">#{phosphorus},</if>
            <if test="potassium != null">#{potassium},</if>
            <if test="signalStrength != null">#{signalStrength},</if>
            <if test="deviceTimestamp != null">#{deviceTimestamp},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <!-- 查询最新的传感器数据（按设备分组，每个设备取最新一条） -->
    <select id="selectLatestSensorData" resultMap="IotSensorDataResult">
        SELECT t1.*
        FROM iot_sensor_data t1
        INNER JOIN (
            SELECT serial_number, MAX(create_time) as max_time
            FROM iot_sensor_data
            GROUP BY serial_number
        ) t2 ON t1.serial_number = t2.serial_number AND t1.create_time = t2.max_time
        ORDER BY t1.create_time DESC
    </select>

    <!-- 查询指定设备的最新传感器数据 -->
    <select id="selectLatestBySerialNumber" resultMap="IotSensorDataResult">
        SELECT *
        FROM iot_sensor_data
        WHERE serial_number = #{serialNumber}
        ORDER BY create_time DESC
        LIMIT 1
    </select>

</mapper>
