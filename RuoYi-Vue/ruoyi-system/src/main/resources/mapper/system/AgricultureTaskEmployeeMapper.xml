<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.AgricultureTaskEmployeeMapper">

    <resultMap type="AgricultureTaskEmployee" id="AgricultureTaskEmployeeResult">
        <result property="assignId"    column="assign_id"    />
        <result property="taskId"    column="task_id"    />
        <result property="batchId"    column="batch_id"    />
        <result property="employeeId"    column="employee_id"    />
        <result property="employeeName"    column="employee_name"    />
        <result property="employeeRole"    column="employee_role"    />
        <result property="assignTime"    column="assign_time"    />
        <result property="isLeader"    column="is_leader"    />
        <result property="workStatus"    column="work_status"    />
        <result property="completionRate"    column="completion_rate"    />
        <result property="remark"    column="remark"    />
        <result property="status"    column="status"    />
        <result property="orderNum"    column="order_num"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <sql id="selectAgricultureTaskEmployeeVo">
        select
            te.assign_id, te.task_id, te.batch_id, te.employee_id,
            COALESCE(te.employee_name, e.employee_name) as employee_name,
            te.employee_role, te.assign_time, te.is_leader, te.work_status, te.completion_rate,
            te.remark, te.status, te.order_num,
            te.create_by, te.create_time, te.update_by, te.update_time, te.del_flag
        from agriculture_task_employee te
        left join agriculture_employee e on te.employee_id = e.employee_id
    </sql>

    <select id="selectAgricultureTaskEmployeeList" parameterType="AgricultureTaskEmployee" resultMap="AgricultureTaskEmployeeResult">
        <include refid="selectAgricultureTaskEmployeeVo"/>
        <where>
            <if test="taskId != null "> and te.task_id = #{taskId}</if>
            <if test="batchId != null "> and te.batch_id = #{batchId}</if>
            <if test="employeeId != null "> and te.employee_id = #{employeeId}</if>
            <if test="employeeName != null  and employeeName != ''"> and COALESCE(te.employee_name, e.employee_name) like concat('%', #{employeeName}, '%')</if>
            <if test="employeeRole != null  and employeeRole != ''"> and te.employee_role = #{employeeRole}</if>
            <if test="isLeader != null  and isLeader != ''"> and te.is_leader = #{isLeader}</if>
            <if test="workStatus != null  and workStatus != ''"> and te.work_status = #{workStatus}</if>
            <if test="status != null  and status != ''"> and te.status = #{status}</if>
        </where>
        order by te.assign_time desc
    </select>

    <select id="selectAgricultureTaskEmployeeByAssignId" parameterType="Long" resultMap="AgricultureTaskEmployeeResult">
        <include refid="selectAgricultureTaskEmployeeVo"/>
        where te.assign_id = #{assignId}
    </select>

    <insert id="insertAgricultureTaskEmployee" parameterType="AgricultureTaskEmployee" useGeneratedKeys="true" keyProperty="assignId">
        insert into agriculture_task_employee
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="taskId != null">task_id,</if>
            <if test="batchId != null">batch_id,</if>
            <if test="employeeId != null">employee_id,</if>
            <if test="employeeName != null and employeeName != ''">employee_name,</if>
            <if test="employeeRole != null and employeeRole != ''">employee_role,</if>
            <if test="assignTime != null">assign_time,</if>
            <if test="isLeader != null and isLeader != ''">is_leader,</if>
            <if test="workStatus != null and workStatus != ''">work_status,</if>
            <if test="completionRate != null">completion_rate,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="orderNum != null">order_num,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="taskId != null">#{taskId},</if>
            <if test="batchId != null">#{batchId},</if>
            <if test="employeeId != null">#{employeeId},</if>
            <if test="employeeName != null and employeeName != ''">#{employeeName},</if>
            <if test="employeeRole != null and employeeRole != ''">#{employeeRole},</if>
            <if test="assignTime != null">#{assignTime},</if>
            <if test="isLeader != null and isLeader != ''">#{isLeader},</if>
            <if test="workStatus != null and workStatus != ''">#{workStatus},</if>
            <if test="completionRate != null">#{completionRate},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="orderNum != null">#{orderNum},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
         </trim>
    </insert>

    <update id="updateAgricultureTaskEmployee" parameterType="AgricultureTaskEmployee">
        update agriculture_task_employee
        <trim prefix="SET" suffixOverrides=",">
            <if test="taskId != null">task_id = #{taskId},</if>
            <if test="batchId != null">batch_id = #{batchId},</if>
            <if test="employeeId != null">employee_id = #{employeeId},</if>
            <if test="employeeName != null and employeeName != ''">employee_name = #{employeeName},</if>
            <if test="employeeRole != null and employeeRole != ''">employee_role = #{employeeRole},</if>
            <if test="assignTime != null">assign_time = #{assignTime},</if>
            <if test="isLeader != null and isLeader != ''">is_leader = #{isLeader},</if>
            <if test="workStatus != null and workStatus != ''">work_status = #{workStatus},</if>
            <if test="completionRate != null">completion_rate = #{completionRate},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="delFlag != null and delFlag != ''">del_flag = #{delFlag},</if>
        </trim>
        where assign_id = #{assignId}
    </update>

    <delete id="deleteAgricultureTaskEmployeeByAssignId" parameterType="Long">
        delete from agriculture_task_employee where assign_id = #{assignId}
    </delete>

    <delete id="deleteAgricultureTaskEmployeeByAssignIds" parameterType="Long">
        delete from agriculture_task_employee where assign_id in
        <foreach item="assignId" collection="array" open="(" separator="," close=")">
            #{assignId}
        </foreach>
    </delete>

    <delete id="deleteAgricultureTaskEmployeeByTaskIdAndEmployeeId">
        delete from agriculture_task_employee
        where task_id = #{taskId} and employee_id = #{employeeId}
    </delete>
</mapper>
